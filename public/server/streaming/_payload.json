ting\u002Freleases","9.contributing\u002F3.releases","i-lucide-rocket",{"title":213,"path":214,"stem":215,"icon":216},"Troubleshooting","\u002Ftroubleshooting","troubleshooting","i-lucide-life-buoy",{"id":218,"title":92,"body":219,"description":1852,"extension":1853,"links":1854,"meta":1855,"navigation":1856,"path":93,"seo":1857,"stem":94,"__hash__":1858},"docs\u002F3.server\u002F3.streaming.md",{"type":220,"value":221,"toc":1840},"minimark",[222,251,256,259,318,349,367,374,380,438,442,533,536,731,736,897,919,922,1184,1212,1239,1244,1258,1424,1436,1440,1500,1509,1673,1708,1730,1734,1737,1744,1754,1767,1771,1774,1812,1819,1823,1836],[223,224,225,226,230,231,234,235,238,239,242,243,246,247,250],"p",{},"Both text and chat completions support streaming. Set ",[227,228,229],"code",{},"\"stream\": true"," on the request body to receive server-sent events (SSE) instead of a single JSON response. The streaming path is implemented in ",[227,232,233],{},"crates\u002Fllama-crab-server\u002Fsrc\u002Fmain.rs"," at the ",[227,236,237],{},"completions"," and ",[227,240,241],{},"chat_completions"," handlers, and the SSE adapter is ",[227,244,245],{},"sse_response"," (",[227,248,249],{},"main.rs:2481",").",[252,253,255],"h2",{"id":254},"sse-envelope","SSE envelope",[223,257,258],{},"Every frame is one of:",[260,261,262,275],"table",{},[263,264,265],"thead",{},[266,267,268,272],"tr",{},[269,270,271],"th",{},"Frame shape",[269,273,274],{},"When emitted",[276,277,278,298,308],"tbody",{},[266,279,280,291],{},[281,282,283,286,287,290],"td",{},[227,284,285],{},"data: {…JSON…}\\n\\n"," (default ",[227,288,289],{},"event:",")",[281,292,293,294,297],{},"A ",[227,295,296],{},"StreamFrame"," from the worker.",[266,299,300,305],{},[281,301,302],{},[227,303,304],{},"event: error\\ndata: \u003Cmessage>\\n\\n",[281,306,307],{},"The worker reported a failure mid-stream.",[266,309,310,315],{},[281,311,312],{},[227,313,314],{},"data: [DONE]\\n\\n",[281,316,317],{},"Always the last frame.",[223,319,320,321,324,325,329,330,333,334,337,338,341,342,344,345,348],{},"The ",[227,322,323],{},"[DONE]"," sentinel is ",[326,327,328],"strong",{},"always"," emitted at the end of the stream, even after an ",[227,331,332],{},"error"," event (",[227,335,336],{},"main.rs:2504","). Clients should consume frames by reading the ",[227,339,340],{},"data:"," field and stop when the value equals ",[227,343,323],{},". Treat any ",[227,346,347],{},"event: error"," frame as a failed request.",[223,350,351,352,355,356,359,360,246,363,366],{},"The HTTP response uses the standard ",[227,353,354],{},"text\u002Fevent-stream"," content type, set by ",[227,357,358],{},"axum::response::sse::Sse",". The server installs ",[227,361,362],{},"KeepAlive::default()",[227,364,365],{},"main.rs:2491",") — axum sends a comment-only frame every ~15 seconds to keep the connection open through intermediaries.",[252,368,370,373],{"id":369},"object-discriminators",[227,371,372],{},"object"," discriminators",[223,375,376,377,379],{},"The streaming frames mirror the OpenAI wire format. The ",[227,378,372],{}," field on each frame tells the client which decoder to use:",[260,381,382,397],{},[263,383,384],{},[266,385,386,389,394],{},[269,387,388],{},"Endpoint",[269,390,391,393],{},[227,392,372],{}," value",[269,395,396],{},"Body field with content",[276,398,399,419],{},[266,400,401,409,414],{},[281,402,403,246,406,290],{},[227,404,405],{},"POST \u002Fv1\u002Fcompletions",[227,407,408],{},"stream: true",[281,410,411],{},[227,412,413],{},"text_completion",[281,415,416],{},[227,417,418],{},"choices[0].text",[266,420,421,428,433],{},[281,422,423,246,426,290],{},[227,424,425],{},"POST \u002Fv1\u002Fchat\u002Fcompletions",[227,427,408],{},[281,429,430],{},[227,431,432],{},"chat.completion.chunk",[281,434,435],{},[227,436,437],{},"choices[0].delta.content",[252,439,441],{"id":440},"chat-streaming","Chat streaming",[443,444,449],"pre",{"className":445,"code":446,"language":447,"meta":448,"style":448},"language-bash shiki 