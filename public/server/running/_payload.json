,554],{},"derive"," features (",[226,557,558],{},"crates\u002Fllama-crab-server\u002Fsrc\u002Fmain.rs:49",").",[561,562,563,588],"table",{},[564,565,566],"thead",{},[567,568,569,573,576,579,582,585],"tr",{},[570,571,572],"th",{},"CLI flag",[570,574,575],{},"Env var",[570,577,578],{},"Type",[570,580,581],{},"Default",[570,583,584],{},"Required",[570,586,587],{},"Notes",[589,590,591,625,655,679,706,733,765,793,820,845,880,902,929,954],"tbody",{},[567,592,593,599,604,607,610,615],{},[594,595,596],"td",{},[226,597,598],{},"--model",[594,600,601],{},[226,602,603],{},"LLAMA_CRAB_MODEL",[594,605,606],{},"path or HF repo id",[594,608,609],{},"—",[594,611,612],{},[238,613,614],{},"Yes",[594,616,617,618,621,622,624],{},"Local GGUF path, or ",[226,619,620],{},"\u003Corg>\u002F\u003Crepo>"," when the ",[226,623,356],{}," feature is enabled.",[567,626,627,632,637,640,642,645],{},[594,628,629],{},[226,630,631],{},"--hf-filename",[594,633,634],{},[226,635,636],{},"LLAMA_CRAB_HF_FILENAME",[594,638,639],{},"string",[594,641,609],{},[594,643,644],{},"No",[594,646,647,648,651,652,654],{},"Pick a specific ",[226,649,650],{},".gguf"," from a multi-file HF repo. Required when ",[226,653,598],{}," is a repo id with more than one GGUF.",[567,656,657,662,667,669,674,676],{},[594,658,659],{},[226,660,661],{},"--host",[594,663,664],{},[226,665,666],{},"LLAMA_CRAB_HOST",[594,668,639],{},[594,670,671],{},[226,672,673],{},"127.0.0.1",[594,675,644],{},[594,677,678],{},"Bind host.",[567,680,681,686,691,696,701,703],{},[594,682,683],{},[226,684,685],{},"--port",[594,687,688],{},[226,689,690],{},"LLAMA_CRAB_PORT",[594,692,693],{},[226,694,695],{},"u16",[594,697,698],{},[226,699,700],{},"8080",[594,702,644],{},[594,704,705],{},"Bind port.",[567,707,708,713,718,720,724,726],{},[594,709,710],{},[226,711,712],{},"--model-name",[594,714,715],{},[226,716,717],{},"LLAMA_CRAB_MODEL_NAME",[594,719,639],{},[594,721,722],{},[226,723,235],{},[594,725,644],{},[594,727,728,729,732],{},"Value returned in every response's ",[226,730,731],{},"model"," field.",[567,734,735,740,745,750,756,758],{},[594,736,737],{},[226,738,739],{},"--n-ctx",[594,741,742],{},[226,743,744],{},"LLAMA_CRAB_N_CTX",[594,746,747],{},[226,748,749],{},"u32",[594,751,752,755],{},[226,753,754],{},"2048"," (legacy)",[594,757,644],{},[594,759,760,761,764],{},"Context size. Ignored when ",[226,762,763],{},"--mobile-preset"," is set.",[567,766,767,772,777,781,786,788],{},[594,768,769],{},[226,770,771],{},"--n-batch",[594,773,774],{},[226,775,776],{},"LLAMA_CRAB_N_BATCH",[594,778,779],{},[226,780,749],{},[594,782,783,755],{},[226,784,785],{},"512",[594,787,644],{},[594,789,790,791,764],{},"Prompt-processing batch size. Ignored when ",[226,792,763],{},[567,794,795,800,805,810,815,817],{},[594,796,797],{},[226,798,799],{},"--n-threads",[594,801,802],{},[226,803,804],{},"LLAMA_CRAB_N_THREADS",[594,806,807],{},[226,808,809],{},"i32",[594,811,812,755],{},[226,813,814],{},"0",[594,816,644],{},[594,818,819],{},"CPU thread count. With mobile presets, also drives batch threads.",[567,821,822,827,832,836,840,842],{},[594,823,824],{},[226,825,826],{},"--n-gpu-layers",[594,828,829],{},[226,830,831],{},"LLAMA_CRAB_N_GPU_LAYERS",[594,833,834],{},[226,835,809],{},[594,837,838,755],{},[226,839,814],{},[594,841,644],{},[594,843,844],{},"Number of transformer layers to offload.",[567,846,847,851,856,859,861,863],{},[594,848,849],{},[226,850,763],{},[594,852,853],{},[226,854,855],{},"LLAMA_CRAB_MOBILE_PRESET",[594,857,858],{},"enum",[594,860,609],{},[594,862,644],{},[594,864,865,866,264,869,264,872,875,876,879],{},"One of ",[226,867,868],{},"low-ram",[226,870,871],{},"balanced",[226,873,874],{},"gpu-max",". Replaces the legacy ",[226,877,878],{},"n_*"," defaults with a coordinated mobile-tuned profile.",[567,881,882,887,892,895,897,899],{},[594,883,884],{},[226,885,886],{},"--mmproj",[594,888,889],{},[226,890,891],{},"LLAMA_CRAB_MMPROJ",[594,893,894],{},"path",[594,896,609],{},[594,898,644],{},[594,900,901],{},"Multimodal project