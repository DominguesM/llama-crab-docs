",{"title":72,"path":73,"stem":74,"icon":75},"Structured Output","\u002Frust\u002Fstructured-output","2.rust\u002F7.structured-output","i-lucide-braces",{"title":77,"icon":78,"path":79,"stem":80,"children":81,"page":34},"Server","i-lucide-server","\u002Fserver","3.server",[82,86,91,96],{"title":83,"path":84,"stem":85,"icon":23},"Running the Server","\u002Fserver\u002Frunning","3.server\u002F1.running",{"title":87,"path":88,"stem":89,"icon":90},"OpenAI-Compatible API","\u002Fserver\u002Fopenai-api","3.server\u002F2.openai-api","i-lucide-cloud",{"title":92,"path":93,"stem":94,"icon":95},"Streaming","\u002Fserver\u002Fstreaming","3.server\u002F3.streaming","i-lucide-radio",{"title":97,"path":98,"stem":99},"Operations","\u002Fserver\u002Foperations","3.server\u002F4.operations",{"title":101,"icon":102,"path":103,"stem":104,"children":105,"page":34},"Tauri","i-lucide-app-window","\u002Ftauri","4.tauri",[106,111,116,121],{"title":107,"path":108,"stem":109,"icon":110},"Tauri Plugin","\u002Ftauri\u002Fplugin","4.tauri\u002F1.plugin","i-lucide-plug",{"title":112,"path":113,"stem":114,"icon":115},"Tauri Permissions","\u002Ftauri\u002Fpermissions","4.tauri\u002F2.permissions","i-lucide-shield",{"title":117,"path":118,"stem":119,"icon":120},"TypeScript Client for Tauri","\u002Ftauri\u002Ftypescript-client","4.tauri\u002F3.typescript-client","i-simple-icons-typescript",{"title":122,"path":123,"stem":124},"Tauri section update notes","\u002Ftauri\u002Fupdate_notes","4.tauri\u002FUPDATE_NOTES",{"title":126,"icon":120,"path":127,"stem":128,"children":129,"page":34},"TypeScript","\u002Ftypescript","5.typescript",[130,134,139],{"title":131,"path":132,"stem":133,"icon":28},"Packages","\u002Ftypescript\u002Fpackages","5.typescript\u002F1.packages",{"title":135,"path":136,"stem":137,"icon":138},"Client Contracts","\u002Ftypescript\u002Fclient-contracts","5.typescript\u002F2.client-contracts","i-lucide-file-code",{"title":140,"path":141,"stem":142},"TypeScript section update notes","\u002Ftypescript\u002Fupdate_notes","5.typescript\u002FUPDATE_NOTES",{"title":144,"icon":145,"path":146,"stem":147,"children":148,"page":34},"Guides","i-lucide-compass","\u002Fguides","6.guides",[149,154,159],{"title":150,"path":151,"stem":152,"icon":153},"Performance","\u002Fguides\u002Fperformance","6.guides\u002F1.performance","i-lucide-gauge",{"title":155,"path":156,"stem":157,"icon":158},"Mobile","\u002Fguides\u002Fmobile","6.guides\u002F2.mobile","i-lucide-smartphone",{"title":160,"path":161,"stem":162,"icon":163},"Troubleshooting Models","\u002Fguides\u002Ftroubleshooting-models","6.guides\u002F3.troubleshooting-models","i-lucide-wrench",{"title":165,"icon":166,"path":167,"stem":168,"children":169,"page":34},"Reference","i-lucide-book-marked","\u002Freference","7.reference",[170,175,180],{"title":171,"path":172,"stem":173,"icon":174},"Crates and packages","\u002Freference\u002Fcrates","7.reference\u002F1.crates","i-lucide-boxes",{"title":176,"path":177,"stem":178,"icon":179},"Cargo features","\u002Freference\u002Fcargo-features","7.reference\u002F2.cargo-features","i-lucide-toggle-right",{"title":181,"path":182,"stem":183,"icon":184},"Versioning","\u002Freference\u002Fversioning","7.reference\u002F3.versioning","i-lucide-git-branch",{"title":186,"icon":187,"path":188,"stem":189,"children":190,"page":34},"Examples","i-lucide-flask-conical","\u002Fexamples","8.examples",[191],{"title":186,"path":192,"stem":193,"icon":187},"\u002Fexamples\u002Fexamples","8.examples\u002F1.examples",{"title":195,"icon":196,"path":197,"stem":198,"children":199,"page":34},"Contributing","i-lucide-git-pull-request-arrow","\u002Fcontributing","9.contributing",[200,204,207],{"title":201,"path":202,"stem":203,"icon":37},"Development","\u002Fcontributing\u002Fdevelopment","9.contributing\u002F1.development",{"title":186,"path":205,"stem":206,"icon":187},"\u002Fcontributing\u002Fexamples","9.contributing\u002F2.examples",{"title":208,"path":209,"stem":210,"icon":211},"Releases","\u002Fcontributing\u002Freleases","9.contributing\u002F3.releases","i-lucide-rocket",{"title":213,"path":214,"stem":215,"icon":216},"Troubleshooting","\u002Ftroubleshooting","troubleshooting","i-lucide-life-buoy",{"id":218,"title":97,"body":219,"description":1170,"extension":1171,"links":1172,"meta":1173,"navigation":634,"path":98,"seo":1174,"stem":99,"__hash__":1181},"docs\u002F3.server\u002F4.operations.md",{"type":220,"value":221,"toc":1147},"minimark",[222,230,235,242,325,344,348,355,365,385,388,393,402,425,461,468,472,482,496,500,516,519,576,580,602,669,698,702,706,715,719,834,838,845,852,856,868,905,908,912,930,950,953,964,968,972,975,1033,1056,1060,1078,1082,1123,1126,1143],[223,224,225,229],"p",{},[226,227,228],"code",{},"llama-crab-server"," is a single-model HTTP process. There is no multi-model routing, no request rate limiting, and no built-in metrics endpoint — operationally, treat each process as one loaded GGUF running on one synchronous worker thread.",[231,232,234],"h2",{"id":233},"process-model","Process model",[223,236,237,238,241],{},"The binary is a tokio + axum application whose entire inference path lives on a single dedicated thread named ",[226,239,240],{},"llama-crab-worker",". The structure is:",[243,244,245,260,282,293,315],"ol",{},[246,247,248,251,252,255,256,259],"li",{},[226,249,250],{},"main"," initialises ",[226,253,254],{},"tracing_subscriber",", parses the CLI, and binds the TCP listener (",[226,257,258],{},"main.rs:645-686",").",[246,261,262,265,266,269,270,273,274,276,277,281],{},[226,263,264],{},"spawn_worker"," (",[226,267,268],{},"main.rs:826",") calls ",[226,271,272],{},"Llama::load"," on the worker thread. If loading fails, the worker exits and ",[226,275,250],{}," returns an error ",[278,279,280],"strong",{},"before"," binding the port — the server never serves requests in a degraded state.",[246,283,284,285,288,289,292],{},"With the worker running, the HTTP ",[226,286,287],{},"Router"," is built and ",[226,290,291],{},"axum::serve"," starts accepting connections.",[246,294,295,296,299,300,303,304,307,308,311,312,259],{},"Each HTTP handler sends a ",[226,297,298],{},"Job"," over a ",[226,301,302],{},"std::sync::mpsc"," channel and awaits a ",[226,305,306],{},"oneshot::Receiver"," (or, for streaming, a ",[226,309,310],{},"tokio_mpsc::UnboundedReceiver"," of ",[226,313,314],{},"StreamFrame",[246,316,317,318,320,321,324],{},"The worker processes one ",[226,319,298],{}," at a time in a ",[226,322,323],{},"for job in rx"," loop. There is no queueing, no concurrency, and no preemption — a long completion blocks all subsequent requests.",[223,326,327,328,331,332,335,336,339,340,343],{},"Because the worker is synchronous and the HTTP layer is async, the server must be ",[226,329,330],{},"cargo run"," with the default ",[226,333,334],{},"rt-multi-thread"," tokio runtime. The axum ",[226,337,338],{},"serve"," call does not install a graceful-shutdown handler, so ",[226,341,342],{},"Ctrl+C"," aborts the process via tokio's default behaviour.",[231,345,347],{"id":346},"startup-banner","Startup banner",[223,349,350,351,354],{},"On a successful start the binary writes a banner to stderr (",[226,352,353],{},"main.rs:676-683","):",[356,357,363],"pre",{"className":358,"code":360,"language":361,"meta":362},[359],"language-text","llama-crab-server listening on http:\u002F\u002F127.0.0.1:8080\n  model : llama-crab\n  routes: \u002Fhealth, \u002Fv1\u002Fmodels, \u002Fv1\u002Fcompletions, \u002Fv1\u002Fchat\u002Fcompletions, \u002Fv1\u002Fembeddings, \u002Fv1\u002Frerank, \u002Fextras\u002Ftokenize, \u002Fextras\u002Ftokenize\u002Fcount, \u002Fextras\u002Fdetokenize\n  ctrl+c to stop\n","text","",[226,364,360],{"__ignoreMap":362},[223,366,367,368,371,372,375,376,379,380,259],{},"The route list is hard-coded in the banner and does not include the alias paths ",[226,369,370],{},"\u002Fv1\u002Freranking",", ",[226,373,374],{},"\u002Frerank",", and ",[226,377,378],{},"\u002Freranking"," even though they are registered. Parse the live process to enumerate every available path (see ",[381,382,384],"a",{"href":383},"#health-and-readiness","Health and readiness",[231,386,384],{"id":387},"health-and-readiness",[389,390,392],"h3",{"id":391},"liveness","Liveness",[223,394,395,265,398,401],{},[226,396,397],{},"GET \u002Fhealth",[226,399,400],{},"main.rs:690",") is a static response that does not inspect the worker:",[356,403,407],{"className":404,"code":405,"language":406,"meta":362,"style":362},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -f http:\u002F\u002F127.0.0.1:8080\u002Fhealth\n","bash",[226,408,409],{"__ignoreMap":362},[410,411,414,418,422],"span",{"class":412,"line":413},"line",1,[410,415,417],{"class":416},"sBMFI","curl",[410,419,421],{"class":420},"sfazB"," -f",[410,423,424],{"class":420}," http:\u002F\u002F127.0.0.1:8080\u002Fhealth\n",[356,426,430],{"className":427,"code":428,"language":429,"meta":362,"style":362},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{ \"status\": \"ok\" }\n","json",[226,431,432],{"__ignoreMap":362},[410,433,434,438,441,445,448,451,453,456,458],{"class":412,"line":413},[410,435,437],{"class":436},"sMK4o","{",[410,439,440],{"class":436}," \"",[410,442,444],{"class":443},"spNyl","status",[410,446,447],{"class":436},"\"",[410,449,450],{"class":436},":",[410,452,440],{"class":436},[410,454,455],{"class":420},"ok",[410,457,447],{"class":436},[410,459,460],{"class":436}," }\n",[223,462,463,464,467],{},"The handler returns ",[226,465,466],{},"200 OK"," as long as the axum process is running. A failure here means the process is down or unreachable, not that the model failed to load.",[389,469,471],{"id":470},"model-verification","Model verification",[223,473,474,477,478,481],{},[226,475,476],{},"GET \u002Fv1\u002Fmodels"," returns the loaded model. Use it to confirm that the right ",[226,479,480],{},"--model-name"," is being advertised and to verify the process is past model loading:",[356,483,485],{"className":404,"code":484,"language":406,"meta":362,"style":362},"curl -f http:\u002F\u002F127.0.0.1:8080\u002Fv1\u002Fmodels\n",[226,486,487],{"__ignoreMap":362},[410,488,489,491,493],{"class":412,"line":413},[410,490,417],{"class":416},[410,492,421],{"class":420},[410,494,495],{"class":420}," http:\u002F\u002F127.0.0.1:8080\u002Fv1\u002Fmodels\n",[389,497,499],{"id":498},"deep-readiness","Deep readiness",[223,501,502,503,506,507,509,510,512,513,515],{},"For deployment readiness, run a small request that matches the model's role. A text completion with a short prompt, an embedding call, or a rerank call all exercise the worker end-to-end. ",[226,504,505],{},"\u002Fhealth"," alone is not enough — a worker that crashed after ",[226,508,264],{}," returned would still respond to ",[226,511,505],{}," with ",[226,514,466],{}," while failing every real request.",[223,517,518],{},"A pragmatic readiness check:",[356,520,522],{"className":404,"code":521,"language":406,"meta":362,"style":362},"# Adjust the role to match the deployment.\ncurl -fsS http:\u002F\u002F127.0.0.1:8080\u002Fv1\u002Fchat\u002Fcompletions \\\n  -H 'content-type: application\u002Fjson' \\\n  -d '{\"model\":\"llama-crab\",\"messages\":[{\"role\":\"user\",\"content\":\"ping\"}],\"max_tokens\":4}'\n",[226,523,524,530,545,562],{"__ignoreMap":362},[410,525,526],{"class":412,"line":413},[410,527,529],{"class":528},"sHwdD","# Adjust the role to match the deployment.\n",[410,531,533,535,538,541],{"class":412,"line":532},2,[410,534,417],{"class":416},[410,536,537],{"class":420}," -fsS",[410,539,540],{"class":420}," http:\u002F\u002F127.0.0.1:8080\u002Fv1\u002Fchat\u002Fcompletions",[410,542,544],{"class":543},"sTEyZ"," \\\n",[410,546,548,551,554,557,560],{"class":412,"line":547},3,[410,549,550],{"class":420},"  -H",[410,552,553],{"class":436}," '",[410,555,556],{"class":420},"content-type: application\u002Fjson",[410,558,559],{"class":436},"'",[410,561,544],{"class":543},[410,563,565,568,570,573],{"class":412,"line":564},4,[410,566,567],{"class":420},"  -d",[410,569,553],{"class":436},[410,571,572],{"class":420},"{\"model\":\"llama-crab\",\"messages\":[{\"role\":\"user\",\"content\":\"ping\"}],\"max_tokens\":4}",[410,574,575],{"class":436},"'\n",[231,577,579],{"id":578},"logging","Logging",[223,581,582,583,586,587,265,590,593,594,597,598,601],{},"The server uses ",[226,584,585],{},"tracing_subscriber::fmt"," with an ",[226,588,589],{},"EnvFilter",[226,591,592],{},"main.rs:646-651","). Without ",[226,595,596],{},"RUST_LOG",", the filter is ",[226,599,600],{},"info",". Useful levels:",[356,603,605],{"className":404,"code":604,"language":406,"meta":362,"style":362},"# Default — startup banner and the listen event.\nRUST_LOG=info llama-crab-server --model \u002Fmodels\u002Fmodel.gguf\n\n# Verbose — request-level tracing from tower_http::trace::TraceLayer.\nRUST_LOG=llama_crab_server=debug,tower_http=info llama-crab-server --model \u002Fmodels\u002Fmodel.gguf\n",[226,606,607,612,630,636,641],{"__ignoreMap":362},[410,608,609],{"class":412,"line":413},[410,610,611],{"class":528},"# Default — startup banner and the listen event.\n",[410,613,614,616,619,621,624,627],{"class":412,"line":532},[410,615,596],{"class":543},[410,617,618],{"class":436},"=",[410,620,600],{"class":420},[410,622,623],{"class":416}," llama-crab-server",[410,625,626],{"class":420}," --model",[410,628,629],{"class":420}," \u002Fmodels\u002Fmodel.gguf\n",[410,631,632],{"class":412,"line":547},[410,633,635],{"emptyLinePlaceholder":634},true,"\n",[410,637,638],{"class":412,"line":564},[410,639,640],{"class":528},"# Verbose — request-level tracing from tower_http::trace::TraceLayer.\n",[410,642,644,646,648,651,653,656,659,661,663,665,667],{"class":412,"line":643},5,[410,645,596],{"class":543},[410,647,618],{"class":436},[410,649,650],{"class":543},"llama_crab_server",[410,652,618],{"class":436},[410,654,655],{"class":420},"debug,",[410,657,658],{"class":543},"tower_http",[410,660,618],{"class":436},[410,662,600],{"class":420},[410,664,623],{"class":416},[410,666,626],{"class":420},[410,668,629],{"class":420},[223,670,671,674,675,678,679,682,683,682,686,689,690,693,694,697],{},[226,672,673],{},"TraceLayer::new_for_http()"," is enabled by default (",[226,676,677],{},"main.rs:673","). With the default config it emits request\u002Fresponse lifecycle events at ",[226,680,681],{},"DEBUG","\u002F",[226,684,685],{},"INFO",[226,687,688],{},"TRACE"," — set ",[226,691,692],{},"RUST_LOG=tower_http=info"," (or ",[226,695,696],{},"debug",") to surface them. The layer does not include request bodies.",[231,699,701],{"id":700},"capacity-planning","Capacity planning",[389,703,705],{"id":704},"one-model-per-process","One model per process",[223,707,708,710,711,714],{},[226,709,228],{}," is a single-model server. To serve multiple models, run multiple processes on different ports and route at a higher layer (e.g. nginx, a sidecar proxy, or a custom gateway). Each process owns its own ",[226,712,713],{},"Llama"," instance and KV cache, with no shared state between them.",[389,716,718],{"id":717},"tuning-knobs","Tuning knobs",[720,721,722,735],"table",{},[723,724,725],"thead",{},[726,727,728,732],"tr",{},[729,730,731],"th",{},"Flag",[729,733,734],{},"Effect",[736,737,738,749,759,769,779,803,821],"tbody",{},[726,739,740,746],{},[741,742,743],"td",{},[226,744,745],{},"--n-ctx",[741,747,748],{},"Context window. Larger contexts cost memory and may force longer prefill latencies.",[726,750,751,756],{},[741,752,753],{},[226,754,755],{},"--n-batch",[741,757,758],{},"Prompt-processing batch size. Larger values use more memory but reduce prefill time.",[726,760,761,766],{},[741,762,763],{},[226,764,765],{},"--n-threads",[741,767,768],{},"CPU decode threads. Set to the number of physical cores; with mobile presets also drives batch threads.",[726,770,771,776],{},[741,772,773],{},[226,774,775],{},"--n-gpu-layers",[741,777,778],{},"Number of transformer layers to offload. Tune until the model fits in VRAM and decode latency stops improving.",[726,780,781,786],{},[741,782,783],{},[226,784,785],{},"--mobile-preset",[741,787,788,789,371,792,371,795,798,799,802],{},"Coordinated trade-off (",[226,790,791],{},"low-ram",[226,793,794],{},"balanced",[226,796,797],{},"gpu-max",") that replaces the legacy ",[226,800,801],{},"n_*"," defaults with mobile-tuned values.",[726,804,805,810],{},[741,806,807],{},[226,808,809],{},"--pooling",[741,811,812,813,816,817,820],{},"Embedding \u002F reranking pooling strategy. Required for some models (",[226,814,815],{},"mean"," for BGE, ",[226,818,819],{},"rank"," for cross-encoders).",[726,822,823,831],{},[741,824,825,371,828],{},[226,826,827],{},"--embeddings",[226,829,830],{},"--reranking",[741,832,833],{},"Load the model in embedding or reranking mode. Must be set at startup; the worker rejects embedding\u002Frerank requests when the corresponding flag is not set.",[389,835,837],{"id":836},"memory-and-concurrency","Memory and concurrency",[223,839,840,841,844],{},"The worker is single-threaded; the server does not pipeline requests. A long generation blocks every other request (their jobs queue in the mpsc channel but their ",[226,842,843],{},"rx.await"," resolves only after the in-flight job returns). For mixed workloads, run multiple processes and load-balance at the HTTP layer.",[223,846,847,848,851],{},"The server applies no ",[226,849,850],{},"RequestBodyLimitLayer"," or request timeout. Multi-GB JSON bodies and unbounded request durations are accepted. Place a reverse proxy in front of the process if you need to enforce either.",[231,853,855],{"id":854},"observability-gaps","Observability gaps",[223,857,858,860,861,864,865,450],{},[226,859,228],{}," does not expose Prometheus metrics, a ",[226,862,863],{},"\u002Fmetrics"," endpoint, an OpenTelemetry exporter, or structured request logs. The only observability surface is ",[226,866,867],{},"tracing",[869,870,871,874,887,895],"ul",{},[246,872,873],{},"The startup banner on stderr.",[246,875,876,877,880,881,265,884,259],{},"A single ",[226,878,879],{},"tracing::info!"," line on ",[226,882,883],{},"listen",[226,885,886],{},"main.rs:684",[246,888,889,892,893,259],{},[226,890,891],{},"tower_http::trace"," request lifecycle events (level controlled by ",[226,894,596],{},[246,896,897,898,901,902,259],{},"Worker errors logged via ",[226,899,900],{},"tracing::error!"," for multimodal projector failures (",[226,903,904],{},"main.rs:891-901",[223,906,907],{},"For production observability, add an external proxy that records HTTP-level metrics (request count, latency, status codes) and rely on the server's logs for inference-side errors.",[231,909,911],{"id":910},"security-posture","Security posture",[223,913,914,915,265,918,921,922,925,926,929],{},"The server is designed for local-inference workflows. The CORS layer is ",[226,916,917],{},"CorsLayer::permissive()",[226,919,920],{},"main.rs:672","), which returns ",[226,923,924],{},"Access-Control-Allow-Origin: *"," and accepts any method or header. Bind to ",[226,927,928],{},"127.0.0.1"," unless you intentionally expose the process:",[356,931,933],{"className":404,"code":932,"language":406,"meta":362,"style":362},"llama-crab-server --host 127.0.0.1 --model \u002Fmodels\u002Fmodel.gguf\n",[226,934,935],{"__ignoreMap":362},[410,936,937,939,942,946,948],{"class":412,"line":413},[410,938,228],{"class":416},[410,940,941],{"class":420}," --host",[410,943,945],{"class":944},"sbssI"," 127.0.0.1",[410,947,626],{"class":420},[410,949,629],{"class":420},[223,951,952],{},"If you bind to a network interface, place authentication, TLS, rate limiting and request-size controls in front of the process — the server itself implements none of these.",[223,954,955,956,959,960,963],{},"The ",[226,957,958],{},"model"," and ",[226,961,962],{},"user"," fields on every request body are read and discarded. The server does not implement per-user or per-tenant separation.",[231,965,967],{"id":966},"error-handling","Error handling",[389,969,971],{"id":970},"non-streaming-routes","Non-streaming routes",[223,973,974],{},"Non-streaming handlers return errors as JSON with status codes:",[720,976,977,990],{},[723,978,979],{},[726,980,981,984,987],{},[729,982,983],{},"Status",[729,985,986],{},"Trigger",[729,988,989],{},"Body",[736,991,992,1007,1020],{},[726,993,994,999,1002],{},[741,995,996],{},[226,997,998],{},"400",[741,1000,1001],{},"Worker validation or processing error",[741,1003,1004],{},[226,1005,1006],{},"{\"error\": {\"message\": \"...\", \"type\": \"invalid_request\"}}",[726,1008,1009,1014,1017],{},[741,1010,1011],{},[226,1012,1013],{},"500",[741,1015,1016],{},"Channel closed or oneshot reply dropped",[741,1018,1019],{},"same envelope",[726,1021,1022,1027,1030],{},[741,1023,1024,1026],{},[226,1025,998],{}," (plain text)",[741,1028,1029],{},"Axum JSON deserialization failure",[741,1031,1032],{},"axum's default body",[223,1034,1035,1036,265,1039,1042,1043,1046,1047,1050,1051,1055],{},"The envelope is constructed by ",[226,1037,1038],{},"error_response",[226,1040,1041],{},"main.rs:2507","); the ",[226,1044,1045],{},"type"," field is always ",[226,1048,1049],{},"\"invalid_request\""," for the JSON form. See the ",[381,1052,1054],{"href":1053},"\u002Fserver\u002Fopenai-api#error-envelope","OpenAI-Compatible API reference"," for the full list of validation errors.",[389,1057,1059],{"id":1058},"streaming-routes","Streaming routes",[223,1061,1062,1063,1065,1066,1069,1070,1073,1074,1077],{},"A streaming request can fail before the SSE response starts (then the error is returned as a normal ",[226,1064,998],{},") or after it starts. Mid-stream failures arrive as ",[226,1067,1068],{},"event: error\\ndata: \u003Cmessage>\\n\\n"," followed by the usual ",[226,1071,1072],{},"data: [DONE]",". See ",[381,1075,92],{"href":1076},"\u002Fserver\u002Fstreaming#error-frames",".",[389,1079,1081],{"id":1080},"common-failure-modes","Common failure modes",[869,1083,1084,1090,1104,1114],{},[246,1085,1086,1089],{},[226,1087,1088],{},"--model"," missing or unreadable: the worker exits during startup, the binary returns an error, and the process terminates without binding the port.",[246,1091,1092,1095,1096,1099,1100,1103],{},[226,1093,1094],{},"--mmproj"," set but binary built without ",[226,1097,1098],{},"--features mtmd",": ",[226,1101,1102],{},"multimodal chat content requires llama-crab-server built with the 'mtmd' feature"," for every chat request that includes media.",[246,1105,1106,1107,1110,1111,1077],{},"Image URL not a local path or ",[226,1108,1109],{},"file:\u002F\u002F"," URL: ",[226,1112,1113],{},"image_url.url must be a local file path or file:\u002F\u002F URL",[246,1115,1116,1119,1120,1077],{},[226,1117,1118],{},"logprobs: true"," on a multimodal chat request: ",[226,1121,1122],{},"logprobs are not supported for multimodal chat",[231,1124,181],{"id":1125},"versioning",[223,1127,1128,1130,1131,1134,1135,1077],{},[226,1129,228],{}," first shipped in ",[278,1132,1133],{},"0.1.4 (2026-06-14)",". The 0.1.5 release moved the documentation site but did not change any server behaviour. The full per-release notes are in ",[381,1136,1140],{"href":1137,"rel":1138},"https:\u002F\u002Fgithub.com\u002FDominguesM\u002Fllama-crab\u002Fblob\u002Fmain\u002FCHANGELOG.md",[1139],"nofollow",[226,1141,1142],{},"llama-crab\u002FCHANGELOG.md",[1144,1145,1146],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-