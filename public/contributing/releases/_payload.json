contributing\u002Freleases","9.contributing\u002F3.releases","i-lucide-rocket",{"title":213,"path":214,"stem":215,"icon":216},"Troubleshooting","\u002Ftroubleshooting","troubleshooting","i-lucide-life-buoy",{"id":218,"title":208,"body":219,"description":387,"extension":388,"links":389,"meta":390,"navigation":391,"path":209,"seo":392,"stem":210,"__hash__":393},"docs\u002F9.contributing\u002F3.releases.md",{"type":220,"value":221,"toc":381},"minimark",[222,226,229,295,300,338,345,356,360],[223,224,225],"p",{},"Release work must keep crates, TypeScript packages, generated API\ndocs, and examples aligned.",[223,227,228],{},"Before release:",[230,231,232,236,239,242,265,292],"ul",{},[233,234,235],"li",{},"Verify crate manifests and feature defaults.",[233,237,238],{},"Verify package manifests and generated TypeScript declarations.",[233,240,241],{},"Run packaging dry-runs where possible.",[233,243,244,245,249,250,253,254,256,257,260,261,264],{},"Confirm the workspace ",[246,247,248],"code",{},"version"," in ",[246,251,252],{},"Cargo.toml"," and the ",[246,255,248],{},"\nfields in ",[246,258,259],{},"packages\u002Fcore\u002Fpackage.json"," and\n",[246,262,263],{},"packages\u002Ftauri\u002Fpackage.json"," all match.",[233,266,267,268,271,272,275,276,275,279,275,282,275,285,275,288,291],{},"Run the ",[246,269,270],{},"CONTRIBUTING.md"," PR checklist locally\n(",[246,273,274],{},"cargo fmt",", ",[246,277,278],{},"cargo clippy -- -D warnings",[246,280,281],{},"cargo test",[246,283,284],{},"cargo doc",[246,286,287],{},"pnpm typecheck",[246,289,290],{},"pnpm test",").",[233,293,294],{},"Rebuild docs from the same source state that will be published.",[296,297,299],"h2",{"id":298},"cross-package-version-alignment","Cross-package version alignment",[223,301,302,303,306,307,310,311,314,315,318,319,322,323,326,327,330,331,334,335,337],{},"The workspace, all Rust crates, and both TypeScript packages should\nmove together. The current release (0.1.8) aligns all Rust crates and\nTypeScript packages to the same version — ",[246,304,305],{},"llama-crab-sys"," is now\npublished in lockstep with the rest of the workspace. The previous\nrelease (0.1.7) fixed a use-after-move\nhazard in the safe Rust crate's self-referential struct layout:\n",[246,308,309],{},"LlamaModel"," and ",[246,312,313],{},"LlamaContext"," use ",[246,316,317],{},"Box\u003C...>"," + ",[246,320,321],{},"NonNull\u003C...>"," instead\nof stacked borrows over ",[246,324,325],{},"&'a LlamaModel",", the drop order is hardened to\nfree ",[246,328,329],{},"context"," before ",[246,332,333],{},"model",", and the lifetime parameter is removed\nfrom ",[246,336,313],{},". The public API surface is unchanged. The previous\nrelease (0.1.6) added Hugging Face Hub support in lockstep across the\nworkspace. Future releases should follow the same pattern: fix the\nissue, document the change, document the feature flags, and bump every\npackage in the same commit.",[223,339,340,341,344],{},"For docs.rs failures, inspect the published ",[246,342,343],{},".crate"," artifact when\ndiagnosing a released version. A fixed local manifest does not change\na tarball that has already been published.",[223,346,347,348,351,352,355],{},"The current MSRV (",[246,349,350],{},"1.88",") is pinned in ",[246,353,354],{},"rust-toolchain.toml",". Bumping\nthe MSRV is a breaking change and requires a major version bump; new\ncode must remain buildable on 1.88.",[296,357,359],{"id":358},"recent-release-highlights","Recent release highlights",[223,361,362,363,366,367,275,370,275,373,376,377,380],{},"The next release notes should keep the same shape as\n",[246,364,365],{},"CHANGELOG.md",": ",[246,368,369],{},"### Added",[246,371,372],{},"### Changed",[246,374,375],{},"### Fixed",", plus a\n",[246,378,379],{},"### Notes"," block when MSRV or major restructure changes are\ninvolved.",{"title":382,"searchDepth":383,"depth":383,"links":384},"",2,[385,386],{"id":298,"depth":383,"text":299},{"id":358,"depth":383,"text":359},"Release checklist for keeping crates, packages, API docs, and examples aligned.","md",null,{},{"icon":211},{"title":208,"description":387},"Il2qcNevAQTEmUZd7EBjMZpjBpcVdbN0QVlwq5wHR6I",[395,397],{"title":186,"path":205,"stem":206,"description":396,"icon":187,"children":-1},"Guidance for adding, validating, and documenting llama-crab examples.",{"title":213,"path":214,"stem":215,"description":398,"icon":216,"children":-1},"Common fixes for server, Tauri IPC, streaming, embeddings, and multimodal issues.",1781622523523]