ng\u002Freleases","9.contributing\u002F3.releases","i-lucide-rocket",{"title":213,"path":214,"stem":215,"icon":216},"Troubleshooting","\u002Ftroubleshooting","troubleshooting","i-lucide-life-buoy",{"id":218,"title":213,"body":219,"description":1121,"extension":1122,"links":1123,"meta":1124,"navigation":1125,"path":214,"seo":1126,"stem":215,"__hash__":1127},"docs\u002Ftroubleshooting.md",{"type":220,"value":221,"toc":1106},"minimark",[222,230,246,251,254,280,294,305,338,351,358,365,401,418,425,432,466,469,518,537,545,548,556,559,565,581,585,595,599,632,636,639,657,678,688,692,695,876,883,943,979,983,1006,1038,1069,1073,1102],[223,224,225,226,229],"p",{},"This page covers common issues for the server, Tauri plugin, and\nTypeScript packages. Model-loading, backend, and allocation issues are\ncovered separately in\n",[227,228,160],"a",{"href":161},".",[223,231,232,233,237,238,242,243,245],{},"The current release is ",[234,235,236],"strong",{},"0.1.8",". Behaviour notes below are verified\nagainst the ",[239,240,241],"code",{},"main"," branch and the ",[239,244,236],{}," source tree.",[247,248,250],"h2",{"id":249},"server-does-not-start","Server does not start",[223,252,253],{},"Check that the model path exists and that the selected backend can\nload it:",[255,256,262],"pre",{"className":257,"code":258,"filename":259,"language":260,"meta":261,"style":261},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","llama-crab-server --model \u002Fabsolute\u002Fpath\u002Fto\u002Fmodel.gguf\n","Terminal","bash","",[239,263,264],{"__ignoreMap":261},[265,266,269,273,277],"span",{"class":267,"line":268},"line",1,[265,270,272],{"class":271},"sBMFI","llama-crab-server",[265,274,276],{"class":275},"sfazB"," --model",[265,278,279],{"class":275}," \u002Fabsolute\u002Fpath\u002Fto\u002Fmodel.gguf\n",[223,281,282,283,286,287,290,291,229],{},"If startup exits after logging a model-load failure, reduce memory\npressure with a smaller model, lower ",[239,284,285],{},"--n-ctx",", lower\n",[239,288,289],{},"--n-gpu-layers",", or try a mobile preset such as\n",[239,292,293],{},"--mobile-preset low-ram",[223,295,296,297,300,301,304],{},"For Hugging Face repository IDs, enable the ",[239,298,299],{},"hf-hub"," cargo feature and\nuse ",[239,302,303],{},"--hf-filename"," to disambiguate the GGUF file inside the repo:",[255,306,308],{"className":257,"code":307,"filename":259,"language":260,"meta":261,"style":261},"llama-crab-server \\\n  --model Qwen\u002FQwen2.5-0.5B-Instruct-GGUF \\\n  --hf-filename qwen2.5-0.5b-instruct-q4_k_m.gguf\n",[239,309,310,318,329],{"__ignoreMap":261},[265,311,312,314],{"class":267,"line":268},[265,313,272],{"class":271},[265,315,317],{"class":316},"sTEyZ"," \\\n",[265,319,321,324,327],{"class":267,"line":320},2,[265,322,323],{"class":275},"  --model",[265,325,326],{"class":275}," Qwen\u002FQwen2.5-0.5B-Instruct-GGUF",[265,328,317],{"class":316},[265,330,332,335],{"class":267,"line":331},3,[265,333,334],{"class":275},"  --hf-filename",[265,336,337],{"class":275}," qwen2.5-0.5b-instruct-q4_k_m.gguf\n",[223,339,340,341,343,344,347,348,229],{},"If ",[239,342,303],{}," is missing for a repo that contains multiple GGUFs,\nthe worker fails with ",[239,345,346],{},"model resolution failed: hf-hub repo has more than one gguf file; pass --hf-filename",". The env-var form is\n",[239,349,350],{},"LLAMA_CRAB_HF_FILENAME",[247,352,354,357],{"id":353},"v1rerank-returns-an-error",[239,355,356],{},"\u002Fv1\u002Frerank"," returns an error",[223,359,360,361,364],{},"The reranking endpoint is disabled unless the process starts with\n",[239,362,363],{},"--reranking",":",[255,366,368],{"className":257,"code":367,"filename":259,"language":260,"meta":261,"style":261},"llama-crab-server \\\n  --model \u002Fmodels\u002Freranker.gguf \\\n  --reranking \\\n  --pooling rank\n",[239,369,370,376,385,392],{"__ignoreMap":261},[265,371,372,374],{"class":267,"line":268},[265,373,272],{"class":271},[265,375,317],{"class":316},[265,377,378,380,383],{"class":267,"line":320},[265,379,323],{"class":275},[265,381,382],{"class":275}," \u002Fmodels\u002Freranker.gguf",[265,384,317],{"class":316},[265,386,387,390],{"class":267,"line":331},[265,388,389],{"class":275},"  --reranking",[265,391,317],{"class":316},[265,393,395,398],{"class":267,"line":394},4,[265,396,397],{"class":275},"  --pooling",[265,399,400],{"class":275}," rank\n",[223,402,403,405,406,409,410,413,414,417],{},[239,404,356],{}," shares the same handler as ",[239,407,408],{},"\u002Fv1\u002Freranking",", ",[239,411,412],{},"\u002Frerank",", and\n",[239,415,416],{},"\u002Freranking"," — switching path will not bypass the flag.",[247,419,421,424],{"id":420},"v1embeddings-fails-or-returns-unexpected-vectors",[239,422,423],{},"\u002Fv1\u002Fembeddings"," fails or returns unexpected vectors",[223,426,427,428,431],{},"Start the server with ",[239,429,430],{},"--embeddings"," for embedding workloads:",[255,433,435],{"className":257,"code":434,"filename":259,"language":260,"meta":261,"style":261},"llama-crab-server \\\n  --model \u002Fmodels\u002Fembed.gguf \\\n  --embeddings \\\n  --pooling mean\n",[239,436,437,443,452,459],{"__ignoreMap":261},[265,438,439,441],{"class":267,"line":268},[265,440,272],{"class":271},[265,442,317],{"class":316},[265,444,445,447,450],{"class":267,"line":320},[265,446,323],{"class":275},[265,448,449],{"class":275}," \u002Fmodels\u002Fembed.gguf",[265,451,317],{"class":316},[265,453,454,457],{"class":267,"line":331},[265,455,456],{"class":275},"  --embeddings",[265,458,317],{"class":316},[265,460,461,463],{"class":267,"line":394},[265,462,397],{"class":275},[265,464,465],{"class":275}," mean\n",[223,467,468],{},"Two important defaults to be aware of:",[470,471,472,497],"ul",{},[473,474,475,478,479,482,483,486,487,489,490,493,494,496],"li",{},[239,476,477],{},"normalize"," defaults to ",[234,480,481],{},"false"," (the previous version of this page\nsaid ",[239,484,485],{},"true","; the actual default is ",[239,488,481],{},", verified against\n",[239,491,492],{},"crates\u002Fllama-crab-server\u002Fsrc\u002Fmain.rs","). Pass ",[239,495,485],{}," in the request\nbody when the consumer code expects a unit-length vector.",[473,498,499,502,503,506,507,510,511,513,514,517],{},[239,500,501],{},"encoding_format"," accepts ",[239,504,505],{},"float"," or ",[239,508,509],{},"base64",". When the request uses\n",[239,512,509],{},", the response item also gets an ",[239,515,516],{},"encoding_format: \"base64\"","\nfield alongside the encoded string.",[223,519,520,521,524,525,528,529,532,533,536],{},"The embedding ",[239,522,523],{},"usage"," object contains ",[239,526,527],{},"prompt_tokens"," and ",[239,530,531],{},"total_tokens","\nonly — there is no ",[239,534,535],{},"completion_tokens"," field on this endpoint.",[247,538,540,541,544],{"id":539},"streaming-returns-done-after-an-error-event","Streaming returns ",[239,542,543],{},"[DONE]"," after an error event",[223,546,547],{},"This is expected for the current SSE implementation. Streaming route\nerrors are emitted as:",[255,549,554],{"className":550,"code":552,"language":553,"meta":261},[551],"language-text","event: error\ndata: \u003Cmessage>\n","text",[239,555,552],{"__ignoreMap":261},[223,557,558],{},"The stream then emits the final:",[255,560,563],{"className":561,"code":562,"language":553,"meta":261},[551],"data: [DONE]\n",[239,564,562],{"__ignoreMap":261},[223,566,567,568,570,571,573,574,576,577,580],{},"Treat the error event as request failure even though ",[239,569,543],{}," follows\nit. The terminal ",[239,572,543],{}," is always emitted, even after an error\nframe, by the implementation in ",[239,575,492],{},"\n(",[239,578,579],{},"chain(stream::once(async { StreamEvent::Done }))",").",[247,582,584],{"id":583},"streaming-completions-reject-multiple-prompts","Streaming completions reject multiple prompts",[223,586,587,590,591,594],{},[239,588,589],{},"\u002Fv1\u002Fcompletions"," supports multiple prompts only in non-streaming mode.\nStreaming completions require exactly one prompt. The same constraint\napplies to the Rust ",[239,592,593],{},"create_completion_stream"," high-level helper.",[247,596,598],{"id":597},"chat-role-is-rejected","Chat role is rejected",[223,600,601,602,409,605,409,608,409,611,413,614,617,618,621,622,624,625,627,628,631],{},"The server accepts ",[239,603,604],{},"system",[239,606,607],{},"user",[239,609,610],{},"assistant",[239,612,613],{},"tool",[239,615,616],{},"function"," roles. The TypeScript Tauri client also accepts ",[239,619,620],{},"developer","\nand maps it to ",[239,623,604],{},", but the Rust server path does not accept\n",[239,626,620],{}," directly. The internal request field is ",[239,629,630],{},"role: string"," —\nthe server's role check uses the literal list above.",[247,633,635],{"id":634},"multimodal-chat-content-is-rejected","Multimodal chat content is rejected",[223,637,638],{},"Multimodal server requests require both:",[470,640,641,651],{},[473,642,643,644,647,648,580],{},"A server binary built with the ",[239,645,646],{},"mtmd"," feature\n(",[239,649,650],{},"cargo install llama-crab-server --features mtmd --force",[473,652,653,654,229],{},"Startup with ",[239,655,656],{},"--mmproj \u002Fpath\u002Fto\u002Fmmproj.gguf",[223,658,659,660,663,664,667,668,528,671,674,675,229],{},"For ",[239,661,662],{},"image_url"," content parts the server accepts local file paths and\n",[239,665,666],{},"data:image\u002F...;base64,..."," URLs. ",[239,669,670],{},"audio_url",[239,672,673],{},"video_url"," parts\nare parsed by the deserializer but rejected at bitmap load time with\n",[239,676,677],{},"unsupported multimodal chat content part type: audio\u002Fvideo",[223,679,680,681,684,685,687],{},"The Tauri plugin accepts the same image inputs. Audio input is\nexplicitly rejected by the plugin with\n",[239,682,683],{},"PluginError { kind: \"mediaDecode\", message: \"audio input is not supported by the plugin yet\" }",". To enable multimodal in a Tauri\napp, the Rust plugin must be built with the ",[239,686,646],{}," cargo feature;\nthe TypeScript client does not enforce this.",[247,689,691],{"id":690},"tauri-ipc-says-a-model-is-not-loaded","Tauri IPC says a model is not loaded",[223,693,694],{},"Load the model before generation, and pass the same model id to chat\nor generation calls:",[255,696,700],{"className":697,"code":698,"language":699,"meta":261,"style":261},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","await client.models.load({\n  model: \"local\",\n  path: \"\u002Fmodels\u002Fmodel.gguf\",\n})\n\nawait client.chat.completions.create({\n  model: \"local\",\n  messages: [{ role: \"user\", content: \"Hello\" }],\n})\n","ts",[239,701,702,729,749,765,773,780,806,821,869],{"__ignoreMap":261},[265,703,704,708,711,714,717,719,723,726],{"class":267,"line":268},[265,705,707],{"class":706},"s7zQu","await",[265,709,710],{"class":316}," client",[265,712,229],{"class":713},"sMK4o",[265,715,716],{"class":316},"models",[265,718,229],{"class":713},[265,720,722],{"class":721},"s2Zo4","load",[265,724,725],{"class":316},"(",[265,727,728],{"class":713},"{\n",[265,730,731,735,737,740,743,746],{"class":267,"line":320},[265,732,734],{"class":733},"swJcz","  model",[265,736,364],{"class":713},[265,738,739],{"class":713}," \"",[265,741,742],{"class":275},"local",[265,744,745],{"class":713},"\"",[265,747,748],{"class":713},",\n",[265,750,751,754,756,758,761,763],{"class":267,"line":331},[265,752,753],{"class":733},"  path",[265,755,364],{"class":713},[265,757,739],{"class":713},[265,759,760],{"class":275},"\u002Fmodels\u002Fmodel.gguf",[265,762,745],{"class":713},[265,764,748],{"class":713},[265,766,767,770],{"class":267,"line":394},[265,768,769],{"class":713},"}",[265,771,772],{"class":316},")\n",[265,774,776],{"class":267,"line":775},5,[265,777,779],{"emptyLinePlaceholder":778},true,"\n",[265,781,783,785,787,789,792,794,797,799,802,804],{"class":267,"line":782},6,[265,784,707],