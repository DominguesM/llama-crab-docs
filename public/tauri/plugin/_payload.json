nc commands).",[223,1164,1165,1166,1168,1169,566,1171,1173,1174,1176,1177,1180,1181,1184,1185,1188,1189,1191],{},"When the ",[226,1167,464],{}," feature is enabled, the worker also owns a ",[226,1170,565],{},[226,1172,468],{},". Chat requests whose messages contain an ",[226,1175,505],{}," (or ",[226,1178,1179],{},"input_audio",") part are routed through the multimodal path, with images decoded from base64 data URLs or loaded from disk. Audio input is currently rejected with ",[226,1182,1183],{},"mediaDecode"," and falls through ",[226,1186,1187],{},"multimodalNotEnabled"," when the ",[226,1190,464],{}," feature is off.",[242,1193,1195],{"id":1194},"streaming-and-cancellation","Streaming and cancellation",[223,1197,1198,450,1200,1202,1203,1205,1206,1208,1209,1211,1212,1215,1216,1218],{},[226,1199,872],{},[226,1201,943],{}," register the request id in ",[226,1204,546],{}," and forward ",[226,1207,886],{}," \u002F ",[226,1210,960],{}," events over the user-supplied Tauri ",[226,1213,1214],{},"Channel",". Each chunk carries the original ",[226,1217,1118],{}," so that the caller can later cancel the stream:",[249,1220,1225],{"className":1221,"code":1222,"language":1223,"meta":1224,"style":254},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","await invoke(\"plugin:llama-crab|cancel\", { requestId })\n","ts","title=\"Cancel an in-flight stream\"",[226,1226,1227],{"__ignoreMap":254},[258,1228,1229,1233,1237,1241,1245,1249,1251,1254,1257,1260,1263],{"class":260,"line":261},[258,1230,1232],{"class":1231},"s7zQu","await",[258,1234,1236],{"class":1235},"s2Zo4"," invoke",[258,1238,1240],{"class":1239},"sTEyZ","(",[258,1242,1244],{"class":1243},"sMK4o","\"",[258,1246,1248],{"class":1247},"sfazB","plugin:llama-crab|cancel",[258,1250,1244],{"class":1243},[258,1252,1253],{"class":1243},",",[258,1255,1256],{"class":1243}," {",[258,1258,1259],{"class":1239}," requestId ",[258,1261,1262],{"class":1243},"}",[258,1264,1265],{"class":1239},