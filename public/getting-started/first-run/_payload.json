n    println!(\"{}\", completion.text);\n    Ok(())\n}\n","rust",[234,285,286,291,297,302,308,314,320,326,332,337,343,349,355],{"__ignoreMap":232},[237,287,288],{"class":239,"line":240},[237,289,290],{},"use llama_crab::{Llama, LlamaParams};\n",[237,292,293],{"class":239,"line":254},[237,294,296],{"emptyLinePlaceholder":295},true,"\n",[237,298,299],{"class":239,"line":263},[237,300,301],{},"fn main() -> Result\u003C(), Box\u003Cdyn std::error::Error>> {\n",[237,303,305],{"class":239,"line":304},4,[237,306,307],{},"    let mut llama = Llama::load(\n",[237,309,311],{"class":239,"line":310},5,[237,312,313],{},"        LlamaParams::new(\"models\u002Fqwen2.5-0.5b-instruct-q4_k_m.gguf\")\n",[237,315,317],{"class":239,"line":316},6,[237,318,319],{},"            .with_n_ctx(2048)\n",[237,321,323],{"class":239,"line":322},7,[237,324,325],{},"            .with_n_threads(4),\n",[237,327,329],{"class":239,"line":328},8,[237,330,331],{},"    )?;\n",[237,333,335],{"class":239,"line":334},9,[237,336,296],{"emptyLinePlaceholder":295},[237,338,340],{"class":239,"line":339},10,[237,341,342],{},"    let completion = llama.create_completion(\"The capital of France is\", 16)?;\n",[237,344,346],{"class":239,"line":345},11,[237,347,348],{},"    println!(\"{}\", completion.text);\n",[237,350,352],{"class":239,"line":351},12,[237,353,354],{},"    Ok(())\n",[237,356,358],{"class":239,"line":357},13,[237,359,360],{},"}\n",[223,362,363],{},"Run in release mode (debug builds are much slower for inference):",[227,365,367],{"className":229,"code":366,"language":231,"meta":232,"style":232},"cargo run --release\n",[234,368,369],{"__ignoreMap":232},[237,370,371,373,376],{"class":239,"line":240},[237,372,244],{"class":243},[237,374,375],{"class":247}," run",[237,377,378],{"class":247}," --release\n",[223,380,381,382,385],{},"If you are working from a source checkout, use the repository example\nwrappers documented in ",[383,384,201],"a",{"href":202},".",[387,388,390],"h2",{"id":389},"loading-from-hugging-face","Loading from Hugging Face",[223,392,393,394,397,398,401,402,405,406,409,410,413],{},"The ",[234,395,396],{},"hf-hub"," feature (enabled by default in ",[234,399,400],{},"tauri-plugin-llama-crab"," and\navailable in the standalone ",[234,403,404],{},"llama-crab"," and ",[234,407,408],{},"llama-crab-server"," crates)\nlets ",[234,411,412],{},"LlamaParams::new"," accept a Hugging Face repository id instead of a\nlocal path:",[227,415,419],{"className":416,"code":417,"language":418,"meta":232,"style":232},"language-rust,no_run shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use llama_crab::{Llama, LlamaParams};\n\nfn main() -> Result\u003C(), Box\u003Cdyn std::error::Error>> {\n    let mut llama = Llama::load(\n        LlamaParams::new(\"Qwen\u002FQwen2.5-0.5B-Instruct-GGUF\")\n            .with_hf_filename(\"qwen2.5-0.5b-instruct-q4_k_m.gguf\")\n            .with_n_ctx(2048),\n    )?;\n    println!(\"{}\", llama.create_completion(\"Hello,\", 8)?.text);\n    Ok(())\n}\n","rust,no_run",[234,420,421,425,429,433,437,442,447,452,456,461,465],{"__ignoreMap":232},[237,422,423],{"class":239,"line":240},[237,424,290],{},[237,426,427],{"class":239,"line":254},[237,428,296],{"emptyLinePlaceholder":295},[237,430,431],{"class":239,"line":263},[237,432,301],{},[237,434,435],{"class":239,"line":304},[237,436,307],{},[237,438,439],{"class":239,"line":310},[237,440,441],{},"        LlamaParams::new(\"Qwen\u002FQwen2.5-0.5B-Instruct-GGUF\")\n",[237,443,444],{"class":239,"line":316},[237,445,446],{},"            .with_hf_filename(\"qwen2.5-0.5b-instruct-q4_k_m.gguf\")\n",[237,448,449],{"class":239,"line":322},[237,450,451],{},"            .with_n_ctx(2048),\n",[237,453,454],{"class":239,"line":328},[237,455,331],{},[237,457,458],{"class":239,"line":334},[237,459,460],{},"    println!(\"{}\", llama.create_completion(\"Hello,\", 8)?.text);\n",[237,462,463],{"class":239,"line":339},[237,464,354],{},[237,466,467],{"class":239,"line":345},[237,4