\u002Fcontributing\u002Freleases","9.contributing\u002F3.releases","i-lucide-rocket",{"title":213,"path":214,"stem":215,"icon":216},"Troubleshooting","\u002Ftroubleshooting","troubleshooting","i-lucide-life-buoy",{"id":218,"title":30,"body":219,"description":403,"extension":404,"links":405,"meta":406,"navigation":407,"path":31,"seo":408,"stem":32,"__hash__":409},"docs\u002F1.getting-started\u002F5.backends.md",{"type":220,"value":221,"toc":401},"minimark",[222,226,238,241,353,356,379,397],[223,224,225],"p",{},"Backends are selected at compile time with Cargo features. The safe Rust API\nthen exposes runtime parameters such as context size, thread count, and GPU\noffload layers.",[223,227,228,229,233,234,237],{},"The crate's default feature set is ",[230,231,232],"code",{},"[\"openmp\", \"metal\"]"," so macOS users get\nCPU + Metal without extra configuration. Override with\n",[230,235,236],{},"default-features = false"," when you target a different accelerator (or\nbuild for CI\u002FLinux without Metal).",[223,239,240],{},"Common combinations:",[242,243,244,257],"table",{},[245,246,247],"thead",{},[248,249,250,254],"tr",{},[251,252,253],"th",{},"Target",[251,255,256],{},"Features",[258,259,260,271,284,296,308,320,332,342],"tbody",{},[248,261,262,266],{},[263,264,265],"td",{},"CPU-only",[263,267,268],{},[230,269,270],{},"openmp",[248,272,273,276],{},[263,274,275],{},"Apple Silicon",[263,277,278,281,282],{},[230,279,280],{},"metal",", ",[230,283,270],{},[248,285,286,289],{},[263,287,288],{},"NVIDIA Linux",[263,290,291,281,294],{},[230,292,293],{},"cuda",[230,295,270],{},[248,297,298,301],{},[263,299,300],{},"AMD Linux",[263,302,303,281,306],{},[230,304,305],{},"rocm",[230,307,270],{},[248,309,310,313],{},[263,311,312],{},"Cross-vendor GPU",[263,314,315,281,318],{},[230,316,317],{},"vulkan",[230,319,270],{},[248,321,322,325],{},[263,323,324],{},"OpenCL accelerator",[263,326,327,281,330],{},[230,328,329],{},"opencl",[230,331,270],{},[248,333,334,337],{},[263,335,336],{},"Arm KleidiAI matrix kernels",[263,338,339],{},[230,340,341],{},"kleidiai",[248,343,344,347],{},[263,345,346],{},"Vision workloads",[263,348,349,350],{},"backend features plus ",[230,351,352],{},"mtmd",[223,354,355],{},"Example:",[357,358,363],"pre",{"className":359,"code":360,"language":361,"meta":362,"style":362},"language-toml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","[dependencies]\nllama-crab = { version = \"0.1.8\", default-features = false, features = [\"metal\", \"openmp\"] }\n","toml","",[230,364,365,373],{"__ignoreMap":362},[366,367,370],"span",{"class":368,"line":369},"line",1,[366,371,372],{},"[dependencies]\n",[366,374,376],{"class":368,"line":375},2,[366,377,378],{},"llama-crab = { version = \"0.1.8\", default-features = false, features = [\"metal\", \"openmp\"] }\n",[223,380,381,382,385,386,389,390,393,394,396],{},"When debugging docs.rs or Linux CI builds, verify transitive default\nfeatures on ",[230,383,384],{},"llama-crab-sys",". A local manifest fix is not proof that a\npublished crate tarball has the same dependency shape. The\n",[387,388,176],"a",{"href":177}," page lists every public feature\non ",[230,391,392],{},"llama-crab"," and the underlying ",[230,395,384],{}," feature for each\nbackend.",[398,399,400],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shik