e":733,"filename":282,"language":283,"meta":284,"style":284},"cargo run --release --bin \u003Cname> -- \\\n    \u003Chf_repo> \u003Chf_filename> [extra args...]\n",[233,735,736,766],{"__ignoreMap":284},[288,737,738,740,742,744,746,750,753,757,760,763],{"class":290,"line":291},[288,739,318],{"class":294},[288,741,321],{"class":298},[288,743,324],{"class":298},[288,745,327],{"class":298},[288,747,749],{"class":748},"sMK4o"," \u003C",[288,751,752],{"class":298},"nam",[288,754,756],{"class":755},"sTEyZ","e",[288,758,759],{"class":748},">",[288,761,762],{"class":298}," --",[288,764,765],{"class":755}," \\\n",[288,767,768,771,774,777,779,781,784,786,788,791],{"class":290,"line":305},[288,769,770],{"class":748},"    \u003C",[288,772,773],{"class":298},"hf_rep",[288,775,776],{"class":755},"o",[288,778,759],{"class":748},[288,780,749],{"class":748},[288,782,783],{"class":298},"hf_filenam",[288,785,756],{"class":755},[288,787,759],{"class":748},[288,789,790],{"class":755}," [extra ",[288,792,793],{"class":298},"args...]\n",[223,795,796,797,799],{},"For vision examples, the second positional argument is the text\nfilename and the third is the ",[233,798,703],{}," filename:",[278,801,803],{"className":280,"code":802,"filename":282,"language":283,"meta":284,"style":284},"cargo run --release --bin vision -- \\\n    unsloth\u002FLFM2.5-VL-1.6B-GGUF \\\n    LFM2.5-VL-1.6B-Q4_K_M.gguf \\\n    mmproj-BF16.gguf\n",[233,804,805,822,829,836],{"__ignoreMap":284},[288,806,807,809,811,813,815,818,820],{"class":290,"line":291},[288,808,318],{"class":294},[288,810,321],{"class":298},[288,812,324],{"class":298},[288,814,327],{"class":298},[288,816,817],{"class":298}," vision",[288,819,762],{"class":298},[288,821,765],{"class":755},[288,823,824,827],{"class":290,"line":305},[288,825,826],{"class":298},"    unsloth\u002FLFM2.5-VL-1.6B-GGUF",[288,828,765],{"class":755},[288,830,831,834],{"class":290,"line":315},[288,832,833],{"class":298},"    LFM2.5-VL-1.6B-Q4_K_M.gguf",[288,835,765],{"class":755},[288,837,839],{"class":290,"line":838},4,[288,840,841],{"class":298},"    mmproj-BF16.gguf\n",[273,843,845],{"id":844},"using-a-different-model","Using a different model",[223,847,848,849,852,853,855],{},"Any HF repo id that contains a ",[233,850,851],{},".gguf"," can be used. If the repo\ncontains multiple ",[233,854,851],{}," files you must pass the filename as the\nsecond positional argument; the auto-pick path refuses to guess\n(there is a clear error in that case).",[223,857,858,859,861],{},"For local files, pass the path instead of the repo id — ",[233,860,262],{},"\nauto-detects that the path exists on disk and skips the HF download.",[273,863,865],{"id":864},"server-example","Server example",[223,867,868,870,871,873,874,876],{},[233,869,659],{}," is the only example that does not compile a self-contained\nRust binary. It resolves the text and ",[233,872,703],{}," GGUFs through HF Hub\nand then spawns the published ",[233,875,671],{}," HTTP binary. Install\nthe server once with:",[278,878,880],{"className":280,"code":879,"filename":282,"language":283,"meta":284,"style":284},"cargo install llama-crab-server --version 0.1.8 --features mtmd --force\n",[233,881,882],{"__ignoreMap":284},[288,883,884,886,889,892,895,898,901,904],{"class":290,"line":291},[288,885,318],{"class":294},[288,887,888],{"class":298}," install",[288,890,891],{"class":298}," llama-crab-server",[288,893,894],{"class":298}," --version",[288,896,250],{"class":897},"sbssI",[288,899,900],{"class":298}," --features",[288,902,903],{"class":298}," mtmd",[288,905,906],{"class":298}," --force\n",[223,908,909,910,913],{},"Then ",[233,911,912],{},"cargo run --release --bin server_lfm"," brings it up against\nLFM2.5-VL 1.6B with the resolved paths.",[273,915,917],{"id":916},"tauri-example","Tauri example",[223,919,920,922,923,926,927,930],{},[233,921,679],{}," is a Tauri 2 desktop chat app. It uses ",[233,924,925],{},"pnpm"," and\nthe ",[233,928,929],{},"tauri"," CLI:",[278,932,934],{"className":280,"code":933,"filename":282,"language":283,"meta":284,"style":284},"cd tauri-chat-lfm\npnpm install\npnpm tauri dev\n",[233,935,936,943,950],{"__ignoreMap":284},[288,937,938,940],{"class":290,"line":291},[288,939,309],{"class":308},[288,941,942],{"class":298}," tauri-chat-lfm\n",[288,944,945,947],{"class":290,"line":305},[288,946,925],{"class":294},[288,948,949],{"class":298}," install\n",[288,951,952,954,957],{"class":290,"line":315},[288,953,925],{"class":294},[288,955,956],{"class":298}," tauri",[288,958,959],{"class":298}," dev\n",[223,961,962,963,966],{},"The Rust side resolves the LFM 350M GGUF on first launch and streams\ndownload progress to the renderer through an IPC channel. The\n",[233,964,965],{},"@llama-crab\u002Ftauri"," client then loads the resolved model into the\nplugin and streams chat completions.",[273,968,970],{"id":969},"hugging-face-authentication","Hugging Face authentication",[223,972,973,974,977,978,981,982,984,985,987,988,990,991,993,994,997],{},"Set ",[233,975,976],{},"HF_TOKEN"," (or use ",[233,979,980],{},"hf auth login"," before running the example)\nto access private or gated repos. The ",[233,983,254],{}," feature of ",[233,986,249],{},"\nand the ",[233,989,254],{}," crate used directly in the vision examples both\nread ",[233,992,976],{}," from the environment via ",[233,995,996],{},"ApiBuilder::from_env()",".",[223,999,1000,1001,1004,1005,1008,1009,1012],{},"To point at an HF mirror, set ",[233,1002,1003],{},"HF_ENDPOINT=https:\u002F\u002Fhf-mirror.com","\n(or use the ",[233,1006,1007],{},"--hf-endpoint"," builder on ",[233,1010,1011],{},"RealHfDownloader"," when\nembedding the loader into your own code).",[273,1014,213],{"id":215},[1016,1017,1018,1042,1057,1082,1091],"ul",{},[1019,1020,1021,1026,1027,1030,1031,1033,1034,1037,1038,1041],"li",{},[245,1022,1023],{},[233,1024,1025],{},"hf-hub feature is disabled"," — you are building with\n",[233,1028,1029],{},"--no-default-features"," or a custom feature set that drops\n",[233,1032,254],{},". The workspace's ",[233,1035,1036],{},"Cargo.toml"," enables it by default;\nuse ",[233,1039,1040],{},"cargo build"," without feature overrides.",[1019,1043,1044,1049,1050,1052,1053,1056],{},[245,1045,1046],{},[233,1047,1048],{},"ambiguous: N gguf files in repo ..."," — the HF repo has more\nthan one ",[233,1051,851],{}," and the example was started without\n",[233,1054,1055],{},"with_hf_filename",". Pass the filename as the second positional\nargument.",[1019,1058,1059,1064,1065,1068,1069,1068,1072,1075,1076,384,1079,997],{},[245,1060,1061],{},[233,1062,1063],{},"failed to allocate context"," — the model needs more memory than\nis available. Try a smaller quant (",[233,1066,1067],{},"Q4_K_M"," → ",[233,1070,1071],{},"Q3_K_M",[233,1073,1074],{},"Q2_K",")\nor reduce ",[233,1077,1078],{},"n_ctx",[233,1080,1081],{},"n_gpu_layers",[1019,1083,1084,1087,1088,1090],{},[245,1085,1086],{},"First build is slow"," — ",[233,1089,340],{}," compiles all 17\nllama.cpp backends (~3 min on a 16-core machine). Subsequent\nbuilds are cached.",[1019,1092,1093,1087,1096,1098],{},[245,1094,1095],{},"First vision run is slow",[233,1097,703],{}," for LFM2.5-VL is ~340 MB.\nSubsequent runs reuse the HF cache.",[273,1100,1102],{"id":1101},"adding-a-new-example","Adding a new example",[223,1104,1105],{},"The boilerplate for a new example crate is ~15 lines:",[278,1107,1111],{"className":1108,"code":1109,"filename":1036,"language":1110,"meta":284,"style":284},"language-toml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# my_example\u002FCargo.toml\n[package]\nname = \"my_example\"\nversion.workspace = true\nedition.workspace = true\nrust-version.workspace = true\npublish = false\n\n[[bin]]\nname = \"my_example\"\npath = \"src\u002Fmain.rs\"\n\n[dependencies]\nllama-crab.workspace = true\nanyhow = \"1\"\n","toml",[233,1112,1113,1118,1123,1128,1133,1139,1145,1151,1158,1164,1169,1175,1180,1186,1192],{"__ignoreMap":284},[288,1114,1115],{"class":290,"l