335,338],{},[288,331,332],{},[230,333,334],{},"cuda-no-vmm",[288,336,337],{},"CUDA without virtual memory management.",[288,339,340],{},[230,341,334],{},[266,343,344,349,352],{},[288,345,346],{},[230,347,348],{},"vulkan",[288,350,351],{},"Vulkan backend.",[288,353,354],{},[230,355,348],{},[266,357,358,363,366],{},[288,359,360],{},[230,361,362],{},"rocm",[288,364,365],{},"AMD ROCm backend.",[288,367,368],{},[230,369,362],{},[266,371,372,377,380],{},[288,373,374],{},[230,375,376],{},"opencl",[288,378,379],{},"OpenCL backend.",[288,381,382],{},[230,383,376],{},[266,385,386,391,394],{},[288,387,388],{},[230,389,390],{},"kleidiai",[288,392,393],{},"Arm KleidiAI matrix kernels.",[288,395,396],{},[230,397,390],{},[266,399,400,405,408],{},[288,401,402],{},[230,403,404],{},"system-ggml",[288,406,407],{},"Link against a system-installed GGML.",[288,409,410],{},[230,411,404],{},[266,413,414,419,422],{},[288,415,416],{},[230,417,418],{},"dynamic-link",[288,420,421],{},"Dynamic native linking of the C++ runtime.",[288,423,424],{},[230,425,418],{},[266,427,428,433,436],{},[288,429,430],{},[230,431,432],{},"dynamic-backends",[288,434,435],{},"Dynamic GGML backend loading.",[288,437,438],{},[230,439,432],{},[266,441,442,447,450],{},[288,443,444],{},[230,445,446],{},"shared-stdcxx",[288,448,449],{},"Statically link libstdc++\u002Flibc++ as shared.",[288,451,452],{},[230,453,446],{},[266,455,456,461,464],{},[288,457,458],{},[230,459,460],{},"static-stdcxx",[288,462,463],{},"Statically link libstdc++\u002Flibc++ as static.",[288,465,466],{},[230,467,460],{},[255,469,471],{"id":470},"optional-capabilities","Optional capabilities",[260,473,474,482],{},[263,475,476],{},[266,477,478,480],{},[269,479,271],{},[269,481,274],{},[283,483,484,498,518,533,551,565],{},[266,485,486,491],{},[288,487,488],{},[230,489,490],{},"common",[288,492,493,494,497],{},"llama.cpp common utilities used by chat and grammar helpers. Required for ",[230,495,496],{},"LlamaSampler::grammar",".",[266,499,500,505],{},[288,501,502],{},[230,503,504],{},"mtmd",[288,506,507,508,510,511,514,515,497],{},"Multimodal (vision\u002Faudio) support through ",[230,509,504],{},". Pulls in ",[230,512,513],{},"image"," and ",[230,516,517],{},"base64",[266,519,520,525],{},[288,521,522],{},[230,523,524],{},"llguidance",[288,526,527,528,514,530,497],{},"Alternative grammar backend. Pulls in ",[230,529,524],{},[230,531,532],{},"toktrie",[266,534,535,540],{},[288,536,537],{},[230,538,539],{},"hf-tokenizer",[288,541,542,543,546,547,550],{},"Hugging Face tokenizer integration (uses ",[230,544,545],{},"tokenizers"," with ",[230,548,549],{},"onig",").",[266,552,553,558],{},[288,554,555],{},[230,556,557],{},"hf-hub",[288,559,560,561,564],{},"Hugging Face Hub model resolution. Lets ",[230,562,563],{},"LlamaParams::new"," accept a HF repo id.",[266,566,567,572],{},[288,568,569],{},[230,570,571],{},"disk-cache",[288,573,574,575,550],{},"Persistent prompt cache support (uses ",[230,576,577],{},"sled",[243,579,581],{"id":580},"llama-crab-server",[230,582,580],{},[223,584,585],{},"The server has no default features. Enable them explicitly:",[260,587,588,596],{},[263,589,590],{},[266,591,592,594],{},[269,593,271],{},[269,595,274],{},[283,597,598,610],{},[266,599,600,604],{},[288,601,602],{},[230,603,504],{},[288,605,606,607,497],{},"Multimodal (image) chat support. Pulls in ",[230,608,609],{},"llama-crab\u002Fmtmd",[266,611,612,616],{},[288,613,614],{},[230,615,557],{},[288,617,618,619,622,623,497],{},"Hugging Face model resolution. Pulls in ",[230,620,621],{},"llama-crab\u002Fhf-hub"," and enables ",[230,624,625],{},"--hf-filename",[223,627,628,629,631,632,635],{},"The server's runtime dependency on ",[230,630,232],{}," always enables\n",[230,633,634],{},"features = [\"common\", \"hf-hub\"]",", so the JSON-Schema grammar sampler\nand HF resolution are available even without an explicit feature flag\nin the consumer's manifest.",[243,637,639],{"id":638},"tauri-plugin-llama-crab",[230,640,638],{},[260,642,643,651],{},[263,644,645],{},[266,646,647,649],{},[269,648,271],{},[269,650,274],{},[283,652,653,669],{},[266,654,655,659],{},[288,656,657],{},[230,658,504],{},[288,660,606,661,663,664,666,667,497],{},[230,662,609],{},", ",[230,665,517],{},", and ",[230,668,513],{},[266,670,671,674],{},[288,672,673],{},"(default)",[288,675,676,678,679,681,682,684,685,688],{},[230,677,638],{}," enables ",[230,680,232],{},"'s ",[230,683,557],{}," feature by default in 0.1.8, so Tauri apps can load HF repo IDs through ",[230,686,687],{},"load_model"," without extra plugin-side feature wiring.",[243,690,692],{"id":691},"picking-the-right-set","Picking the right set",[223,694,695],{},"Do not assume platform-specific defaults. Pin the features you need in\nyour application manifest and confirm them against the generated Rust\nAPI reference or the crate metadata for the release you consume.",[223,697,698,699,702],{},"A common pattern for cross-platform apps is to expose backend\nselection through Cargo ",[230,700,701],{},"[features]"," so the same source tree can build\nfor Metal, CUDA, Vulkan, or CPU-only targets:",[704,705,710],"pre",{"className":706,"code":707,"language":708,"meta":709,"style":709},"language-toml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","[features]\ndefault = []\nmetal = [\"llama-crab\u002Fmetal\", \"llama-crab\u002Fopenmp\"]\ncuda = [\"llama-crab\u002Fcuda\", \"llama-crab\u002Fopenmp\"]\nvulkan = [\"llama-crab\u002Fvulkan\", \"llama-crab\u002Fopenmp\"]\ncpu = [\"llama-crab\u002Fopenmp\"]\n","toml","",[230,711,712,720,726,732,738,744],{"__ignoreMap":709},[713,714,717],"span",{"class":715,"line":716},"line",1,[713,718,719],{},"[features]\n",[713,721,723],{"class":715,"line":722},2,[713,724,725],{},"default = []\n",[713,727,729],{"class":715,"line":728},3,[713,730,731],{},"metal = [\"llama-crab\u002Fmetal\", \"llama-crab\u002Fopenmp\"]\n",[713,733,735],{"class":715,"line":734},4,[713,736,737],{},"cuda = [\"llama-crab\u002Fcuda\", \"llama-crab\u002Fopenmp\"]\n",[713,739,741],{"class":715,"line":740},5,[713,742,743],{},"vulkan = [\"llama-crab\u002Fvulkan\", \"llama-crab\u002Fopenmp\"]\n",[713,745,747],{"class":715,"line":746},6,[713,748,749],{},"cpu = [\"llama-crab\u002Fopenmp\"]\n",[751,752,753],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":709,"searchDepth":722,"depth":722,"links":755},[756,760,761,762],{"id":232,"depth":722,"text":232,"children":757},[758,759],{"id":257,"depth":728,"text":258},{"id":470,"depth":728,"text":471},{"id":580,"depth":722,"text":580},{"id":638,"depth":722,"text":638},{"id":691,"depth":722,"text":692},"Feature flags for native backends and optional llama-crab capabilities.",