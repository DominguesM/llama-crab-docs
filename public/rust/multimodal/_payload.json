\u002Freleases","9.contributing\u002F3.releases","i-lucide-rocket",{"title":213,"path":214,"stem":215,"icon":216},"Troubleshooting","\u002Ftroubleshooting","troubleshooting","i-lucide-life-buoy",{"id":218,"title":67,"body":219,"description":960,"extension":961,"links":962,"meta":963,"navigation":964,"path":68,"seo":965,"stem":69,"__hash__":966},"docs\u002F2.rust\u002F6.multimodal.md",{"type":220,"value":221,"toc":951},"minimark",[222,252,275,282,287,294,341,345,348,400,629,662,666,671,732,749,753,778,838,842,845,853,863,866,870,880,916,922,926,947],[223,224,225,226,230,231,234,235,238,239,243,244,247,248,251],"p",{},"Multimodal support is behind the ",[227,228,229],"code",{},"mtmd"," cargo feature and is implemented\non top of ",[227,232,233],{},"llama.cpp","'s ",[227,236,237],{},"tools\u002Fmtmd\u002F"," C API. It supports both ",[240,241,242],"strong",{},"vision","\n(images) and ",[240,245,246],{},"audio"," waveforms, and pairs a text GGUF with a matching\n",[227,249,250],{},"mmproj"," projector file.",[253,254,259],"pre",{"className":255,"code":256,"language":257,"meta":258,"style":258},"language-toml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","[dependencies]\nllama-crab = { version = \"0.1\", features = [\"mtmd\"] }\n","toml","",[227,260,261,269],{"__ignoreMap":258},[262,263,266],"span",{"class":264,"line":265},"line",1,[262,267,268],{},"[dependencies]\n",[262,270,272],{"class":264,"line":271},2,[262,273,274],{},"llama-crab = { version = \"0.1\", features = [\"mtmd\"] }\n",[223,276,277,278,281],{},"For source checkout examples and model download helpers, see\n",[279,280,201],"a",{"href":202},".",[283,284,286],"h2",{"id":285},"top-level-types","Top-level types",[223,288,289,290,293],{},"The ",[227,291,292],{},"llama_crab::multimodal"," module exposes:",[295,296,297,304,310,316,329,335],"ul",{},[298,299,300,303],"li",{},[227,301,302],{},"MtmdContext"," — the projector context bound to a text model.",[298,305,306,309],{},[227,307,308],{},"MtmdBitmap"," — a single image or audio waveform to feed in.",[298,311,312,315],{},[227,313,314],{},"MtmdInputText"," — the textual prompt accompanying the bitmaps.",[298,317,318,321,322,325,326,281],{},[227,319,320],{},"MtmdInputChunks"," and ",[227,323,324],{},"MtmdInputChunk"," — the list of tokenized chunks\nproduced by ",[227,327,328],{},"MtmdContext::tokenize",[298,330,331,334],{},[227,332,333],{},"MtmdContextParams"," — projector init parameters (use GPU, print\ntimings, thread count).",[298,336,337,340],{},[227,338,339],{},"default_media_marker()"," — the placeholder string that must appear\nin the prompt, one occurrence per bitmap.",[283,342,344],{"id":343},"core-flow","Core flow",[223,346,347],{},"The high-level vision examples follow the same sequence:",[349,350,351,357,363,368,374,379,390],"ol",{},[298,352,353,354,281],{},"Load the text model with ",[227,355,356],{},"Llama::load",[298,358,359,360,362],{},"Initialize ",[227,361,302],{}," from the projector file.",[298,364,365,366,281],{},"Load an image as ",[227,367,308],{},[298,369,370,371,373],{},"Insert ",[227,372,339],{}," into the prompt, one occurrence\nper bitmap supplied.",[298,375,376,377,281],{},"Tokenize text plus media with ",[227,378,328],{},[298,380,381,382,385,386,389],{},"Evaluate the chunks into the llama context via\n",[227,383,384],{},"MtmdInputChunks::eval"," (the multimodal eval loop, not ",[227,387,388],{},"decode",").",[298,391,392,393,396,397,281],{},"Sample tokens and feed each sampled token back through the context\nwith a normal ",[227,394,395],{},"LlamaBatch"," + ",[227,398,399],{},"LlamaContext::decode",[253,401,405],{"className":402,"code":403,"language":404,"meta":258,"style":258},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use llama_crab::multimodal::{\n    default_media_marker, MtmdBitmap, MtmdContext, MtmdContextParams, MtmdInputText,\n};\nuse llama_crab::{Llama, LlamaParams};\n\nlet mut llama = Llama::load(\n    LlamaParams::new(\"models\u002Fgemma-4-E4B-it-Q4_K_M.gguf\").with_n_ctx(4096),\n)?;\nlet mtmd = MtmdContext::init_from_file(\n    \"models\u002Fgemma-4-E4B-it-mmproj.gguf\",\n    llama.model(),\n)?;\n\n\u002F\u002F Sanity check: some projectors do not support images or audio.\nif !mtmd.support_vision() {\n    anyhow::bail!(\"this projector does not support vision\");\n}\n\nlet bitmap = MtmdBitmap::from_file(\"images\u002Fsample.png\")?;\nlet marker = default_media_marker();\nlet prompt = format!(\"{marker}\\nDescribe this image.\");\nlet chunks = mtmd.tokenize(MtmdInputText::new(&prompt), &[&bitmap])?;\n\n\u002F\u002F Evaluate the multimodal chunks, then sample + decode token-by-token.\n\u002F\u002F `chunks.eval` is `pub unsafe fn` because it takes a raw `*mut llama_context`.\nlet llama_ctx = llama.context().raw_handle();\nlet n_past = unsafe {\n    chunks.eval(\n        &mtmd,\n        llama_ctx,\n        \u002F* n_past *\u002F 0,\n        \u002F* seq_id *\u002F 0,\n        \u002F* n_batch *\u002F 512,\n        \u002F* logits_last *\u002F true,\n    )\n}?;\n\n\u002F\u002F ... sample from current logits, decode a single token, repeat.\n","rust",[227,406,407,412,417,423,429,436,442,448,454,460,466,472,477,482,488,494,500,506,511,517,523,529,535,540,546,552,558,564,570,576,582,588,594,600,606,612,618,623],{"__ignoreMap":258},[262,408,409],{"class":264,"line":265},[262,410,411],{},"use llama_crab::multimodal::{\n",[262,413,414],{"class":264,"line":271},[262,415,416],{},"    default_media_marker, MtmdBitmap, MtmdContext, MtmdContextParams, MtmdInputText,\n",[262,418,420],{"class":264,"line":419},3,[262,421,422],{},"};\n",[262,424,426],{"class":264,"line":425},4,[262,427,428],{},"use llama_crab::{Llama, LlamaParams};\n",[262,430,432],{"class":264,"line":431},5,[262,433,435],{"emptyLinePlaceholder":434},true,"\n",[262,437,439],{"class":264,"line":438},6,[262,440,441],{},"let mut llama = Llama::load(\n",[262,443,445],{"class":264,"line":444},7,[262,446,447],{},"    LlamaParams::new(\"models\u002Fgemma-4-E4B-it-Q4_K_M.gguf\").with_n_ctx(4096),\n",[262,449,451],{"class":264,"line":450},8,[262,452,453],{},")?;\n",[262,455,457],{"class":264,"line":456},9,[262,458,459],{},"let mtmd = MtmdContext::init_from_file(\n",[262,461,463],{"class":264,"line":462},10,[262,464,465],{},"    \"models\u002Fgemma-4-E4B-it-mmproj.gguf\",\n",[262,467,469],{"class":264,"line":468},11,[262,470,471],{},"    llama.model(),\n",[262,473,475],{"class":264,"line":474},12,[262,476,453],{},[262,478,480],{"class":264,"line":479},13,[262,481,435],{"emptyLinePlaceholder":434},[262,483,485],{"class":264,"line":484},14,[262,486,487],{},"\u002F\u002F Sanity check: some projectors do not support images or audio.\n",[262,489,491],{"class":264,"line":490},15,[262,492,493],{},"if !mtmd.support_vision() {\n",[262,495,497],{"class":264,"line":496},16,[262,498,499],{},"    anyhow::bail!(\"this projector does not support vision\");\n",[262,501,503],{"class":264,"line":502},17,[262,504,505],{},"}\n",[262,507,509],{"class":264,"line":508},18,[262,510,435],{"emptyLinePlaceholder":434},[262,512,514],{"class":264,"line":513},19,[262,515,516],{},"let bitmap = MtmdBitmap::from_file(\"images\u002Fsample.png\")?;\n",[262,518,520],{"class":264,"line":519},20,[262,521,522],{},"let marker = default_media_marker();\n",[262,524,526],{"class":264,"line":525},21,[262,527,528],{},"let prompt = format!(\"{marker}\\nDescribe this image.\");\n",[262,530,532],{"class":264,"line":531},22,[262,533,534],{},"let chunks = mtmd.tokenize(MtmdInputText::new(&prompt), &[&bitmap])?;\n",[262,536,538],{"class":264,"line":537},23,[262,539,435],{"emptyLinePlaceholder":434},[262,541,543],{"class":264,"line":542},24,[262,544,545],{},"\u002F\u002F Evaluate the multimodal chunks, then sample + decode token-by-token.\n",[262,547,549],{"class":264,"line":548},25,[262,550,551],{},"\u002F\u002F `chunks.eval` is `pub unsafe fn` because it takes a raw `*mut llama_context`.\n",[262,553,555],{"class":264,"line":554},26,[262,556,557],{},"let llama_ctx = llama.context().raw_handle();\n",[262,559,561],{"class":264,"line":560},27,[262,562,563],{},"let n_past = unsafe {\n",[262,565,567],{"class":264,"line":566},28,[262,568,569],{},"    chunks.eval(\n",[262,571,573],{"class":264,"line":572},29,[262,574,575],{},"        &mtmd,\n",[262,577,579],{"class":264,"line":578},30,[262,580,581],{},"        llama_ctx,\n",[262,583,585],{"class":264,"line":584},31,[262,586,587],{},"        \u002F* n_past *\u002F 0,\n",[262,589,591],{"class":264,"line":590},32,[262,592,593],{},"        \u002F* seq_id *\u002F 0,\n",[262,595,597],{"class":264,"line":596},33,[262,598,599],{},"        \u002F* n_batch *\u002F 512,\n",[262,601,603],{"class":264,"line":602},34,[262,604,605],{},"        \u002F* logits_last *\u002F true,\n",[262,607,609],{"class":264,"line":608},35,[262,610,611],{},"    )\n",[262,613,615],{"class":264,"line":614},36,[262,616,617],{},"}?;\n",[262,619,621],{"class":264,"line":620},37,[262,622,435],{"emptyLinePlaceholder":434},[262,624,626],{"class":264,"line":625},38,[262,627,628],{},"\u002F\u002F ... sample from current logits, decode a single token, repeat.\n",[223,630,631,321,633,635,636,639,640,643,644,647,648,651,652,654,655,658,659,389],{},[227,632,302],{},[227,634,320],{}," are ",[227,637,638],{},"Send"," (not ",[227,641,642],{},"Sync","). The\n",[227,645,646],{},"raw_handle()"," accessor on ",[227,649,650],{},"LlamaContext"," is public specifically so\nthat ",[227,653,384],{}," can be called with a live ",[227,656,657],{},"llama_context","\npointer (see ",[227,660,661],{},"src\u002Fcontext\u002Fmod.rs",[283,663,665],{"id":664},"bitmaps-image-and-audio","Bitmaps: image and audio",[223,667,668,670],{},[227,669,308],{}," has three constructors:",[672,673,674,687],"table",{},[675,676,677],"thead",{},[678,679,680,684],"tr",{},[681,682,683],"th",{},"Constructor",[681,685,686],{},"Use",[688,689,690,705,715],"tbody",{},[678,691,692,698],{},[693,694,695],"td",{},[227,696,697],{},"from_image_data(nx, ny, data)",[693,699,700,701,704],{},"RGB8 pixel buffer, ",[227,702,703],{},"nx * ny * 3"," bytes.",[678,706,707,712],{},[693,708,709],{},[227,710,711],{},"from_audio_data(data)",[693,713,714],{},"Float audio buffer; the projector is responsible for resampling.",[678,716,717,722],{},[693,718,719],{},[227,720,721],{},"from_file(path)",[693,723,724,725,727,728,731],{},"Decode an image from disk (requires the ",[227,726,229],{}," feature, which pulls in the ",[227,729,730],{},"image"," crate).",[223,733,734,321,737,740,741,744,745,748],{},[227,735,736],{},"support_audio()",[227,738,739],{},"audio_sample_rate()"," describe whether the\nprojector handles audio and at which rate. The\n",[227,742,743],{},"Llama::load(…).with_n_ctx(4096)"," context is normally large enough to\nhost the image token expansion; a small ",[227,746,747],{},"n_ctx"," will truncate the image.",[283,750,752],{"id":751},"projector-parameters","Projector parameters",[223,754,755,758,759,761,762,765,766,769,770,773,774,777],{},[227,756,757],{},"MtmdContext::init_from_file(path, model)"," uses default\n",[227,760,333],{}," (",[227,763,764],{},"use_gpu = true",", ",[227,767,768],{},"print_timings = false",",\n",[227,771,772],{},"n_threads = 1","). Pass ",[227,775,776],{},"MtmdContext::init_from_file_with(path, model, params)"," to override:",[253,779,781],{"className":402,"code":780,"language":404,"meta":258,"style":258},"use llama_crab::multimodal::{MtmdContext, MtmdContextParams};\n\nlet params = MtmdContextParams {\n    use_gpu: true,\n    print_timings: true,\n    n_threads: 4,\n};\nlet mtmd = MtmdContext::init_from_file_with(\n    \"models\u002Fgemma-4-E4B-it-mmproj.gguf\",\n    llama.model(),\n    params,\n)?;\n",[227,782,783,788,792,797,802,807,812,816,821,825,829,834],{"__ignoreMap":258},[262,784,785],{"class":264,"line":265},[262,786,787],{},"use llama_crab::multimodal::{MtmdContext, MtmdContextParams};\n",[262,789,790],{"class":264,"line":271},[262,791,435],{"emptyLinePlaceholder":434},[262,793,794],{"class":264,"line":419},[262,795,796],{},"let params = MtmdContextParams {\n",[262,798,799],{"class":264,"line":425},[262,800,801],{},"    use_gpu: true,\n",[262,803,804],{"class":264,"line":431},[262,805,806],{},"    print_timings: true,\n",[262,808,809],{"class":264,"line":438},[262,810,811],{},"    n_threads: 4,\n",[262,813,814],{"class":264,"line":444},[262,815,422],{},[262,817,818],{"class":264,"line":450},[262,819,820],{},"let mtmd = MtmdContext::init_from_file_with(\n",[262,822,823],{"class":264,"line":456},[262,824,465],{},[262,826,827],{"class":264,"line":462},[262,828,471],{},[262,830,831],{"class":264,"line":468},[262,832,833],{},"    params,\n",[262,835,836],{"class":264,"line":474},[262,837,453],{},[283,839,841],{"id":840},"prompt-templates","Prompt templates",[223,843,844],{},"Some vision-language models need model-specific chat framing. The LFM\nexamples wrap the media marker in ChatML-style turns:",[253,846,851],{"className":847,"code":849,"language":850,"meta":258},[848],"language-text","\u003C|im_start|>user\n\u003Cmedia marker>\nDescribe this image.\u003C|im_end|>\n\u003C|im_start|>assistant\n","text",[227,852,849],{"__ignoreMap":258},[223,854,855,856,858,859,862],{},"The literal media marker is whatever ",[227,857,339],{}," returns\n(currently ",[227,860,861],{},"\"\u003C__media__>\"","). Place exactly one marker per bitmap.",[223,864,865],{},"If a model returns empty or irrelevant image answers, verify that the\nprojector matches the text GGUF and that the prompt format matches the\nmodel family.",[283,867,869],{"id":868},"http-server","HTTP server",[223,871,872,873,875,876,879],{},"The server can also run multimodal chat when installed with ",[227,874,229],{}," and\nstarted with ",[227,877,878],{},"--mmproj",":",[253,881,885],{"className":882,"code":883,"language":884,"meta":258,"style":258},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","llama-crab-server \\\n  --model \u002Fmodels\u002Fvision.gguf \\\n  --mmproj \u002Fmodels\u002Fmmproj.gguf\n","bash",[227,886,887,897,908],{"__ignoreMap":258},[262,888,889,893],{"class":264,"line":265},[262,890,892],{"class":891},"sBMFI","llama-crab-server",[262,894,896],{"class":895},"sTEyZ"," \\\n",[262,898,899,903,906],{"class":264,"line":271},[262,900,902],{"class":901},"sfazB","  --model",[262,904,905],{"class":901}," \u002Fmodels\u002Fvision.gguf",[262,907,896],{"class":895},[262,909,910,913],{"class":264,"line":419},[262,911,912],{"class":901},"  --mmproj",[262,914,915],{"class":901}," \u002Fmodels\u002Fmmproj.gguf\n",[223,917,918,919,281],{},"Send image content parts to ",[227,920,921],{},"\u002Fv1\u002Fchat\u002Fcompletions",[283,923,925],{"id":924},"tauri-plugin","Tauri plugin",[223,927,928,931,932,934,935,938,939,942,943,946],{},[227,929,930],{},"tauri-plugin-llama-crab"," also ships a multimodal path. When the plugin\nis built with the ",[227,933,229],{}," cargo feature, ",[227,936,937],{},"load_model"," accepts an\n",[227,940,941],{},"mmproj_path"," and the chat pipeline runs multimodal inference; image\ninputs are accepted as ",[227,944,945],{},"data:image\u002F...;base64,..."," URLs and as local\nfile paths. See the Tauri plugin guide for the IPC contract.",[948,949,950],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-de