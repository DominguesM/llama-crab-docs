6,827],{"class":263,"line":445},[227,828,829],{},"println!(\"\\nfinal: {}\", assistant.content);\n",[223,831,832,833,836],{},"The high-level method ",[230,834,835],{},"llama.create_chat_completion_stream(messages, max_tokens, on_chunk)","\nis also available as a shortcut for the Plain template.",[268,838,840],{"id":839},"tool-calling","Tool calling",[223,842,843,846,847,357],{},[230,844,845],{},"llama_crab::chat::tool_call"," provides tool definitions, a stateful\nparser and OpenAI-style streaming deltas. Five wire formats are\nsupported via ",[230,848,849],{},"ToolFormat",[851,852,853,869],"table",{},[854,855,856],"thead",{},[857,858,859,863,866],"tr",{},[860,861,862],"th",{},"Format",[860,864,865],{},"Token wrapping",[860,867,868],{},"Suggested for",[870,871,872,888,903,915,927],"tbody",{},[857,873,874,880,885],{},[875,876,877,879],"td",{},[230,878,463],{}," (default)",[875,881,882],{},[230,883,884],{},"\u003Ctool_call>{...}\u003C\u002Ftool_call>",[875,886,887],{},"Qwen 2.5, Hermes, generic ChatML",[857,889,890,895,900],{},[875,891,892],{},[230,893,894],{},"Mistral",[875,896,897],{},[230,898,899],{},"[TOOL_CALLS][{...}]",[875,901,902],{},"Mistral \u002F Mixtral",[857,904,905,909,912],{},[875,906,907],{},[230,908,471],{},[875,910,911],{},"`\u003C",[875,913,914],{},"python_tag",[857,916,917,921,924],{},[875,918,919],{},[230,920,277],{},[875,922,923],{},"(none, raw JSON)",[875,925,926],{},"Custom prompts",[857,928,929,934,936],{},[875,930,931],{},[230,932,933],{},"Functionary",[875,935,911],{},[875,937,938],{},"start",[223,940,941,944,945,948,949,952,953,956],{},[230,942,943],{},"ToolFormat::from_chat_format(name)"," auto-detects the format from the\nchat template name. ",[230,946,947],{},"ToolParser"," is the stateful byte-by-byte parser for\nnon-streaming use; ",[230,950,951],{},"ToolCallStream"," emits ",[230,954,955],{},"ToolCallDelta { index, id, name, arguments, completed }"," chunks and is the right tool for SSE-style\nstreams.",[223,958,959,960,963,964,966],{},"The lower-level chat module also ships a pure-Rust Jinja2-subset\nrenderer in ",[230,961,962],{},"chat::render_template(template, messages, tools, add_generation_prompt)",".\nThis is the path to use when the model ships a custom template string\nthat none of the ",[230,965,232],{}," variants cover.",[968,969,971],"h3",{"id":970},"defining-a-tool","Defining a tool",[253,973,975],{"className":255,"code":974,"language":257,"meta":258,"style":258},"use llama_crab::chat::ToolDefinition;\nuse serde_json::json;\n\nlet get_weather = ToolDefinition::new(\n    \"get_weather\",\n    \"Return the current weather for a city.\",\n)\n.with_parameters(json!({\n    \"type\": \"object\",\n    \"properties\": {\n        \"city\": { \"type\": \"string\" }\n    },\n    \"required\": [\"city\"]\n}));\n",[230,976,977,982,987,991,996,1001,1006,1011,1016,1021,1026,1031,1035,1040],{"__ignoreMap":258},[227,978,979],{"class":263,"line":264},[227,980,981],{},"use llama_crab::chat::ToolDefinition;\n",[227,983,984],{"class":263,"line":291},[227,985,986],{},"use serde_json::json;\n",[227,988,989],{"class":263,"line":298},[227,990,295],{"emptyLinePlaceholder":294},[227,992,993],{"class":263,"line":304},[227,994,995],{},"let get_weather = ToolDefinition::new(\n",[227,997,998],{"class":263,"line":310},[227,999,1000],{},"    \"get_weather\",\n",[227,1002,1003],{"class":263,"line":316},[227,1004,1005],{},"    \"Return the current weather for a city.\",\n",[227,1007,1008],{"class":263,"line":322},[227,1009,1010],{},")\n",[227,1012,1013],{"class":263,"line":328},[227,1014,1015],{},".with_parameters(json!({\n",[227,1017,1018],{"class":263,"line":333},[227,1019,1020],{},"    \"type\": \"object\",\n",[227,1022,1023],{"class":263,"line":339},[227,1024,1025],{},"    \"properties\": {\n",[227,1027,1028],{"class":263,"line":409},[227,1029,1030],{},"        \"city\": { \"type\": \"string\" }\n",[227,1032,1033],{"class":263,"line":415},[227,1034,820],{},[227,1036,1037],{"class":263,"line":421},[227,1038,1039],{},"    \"required\": [\"city\"]\n",[227,1041,1042],{"class":263,"line":427},[227,1043,1044],{},"}));\n",[968,1046,1048],{"id":1047},"parsing-a-non-streaming-response","Parsing a non-streaming response",[253,1050,1052],{"className":255,"code":1051,"language":257,"meta":258,"style":258},"use llama_crab::chat::tool_call::{extract_tool_calls, ToolFormat};\n\nlet raw = r#\"\u003Ctool_call>{\"name\":\"get_weather\",\"arguments\":{\"city\":\"Tokyo\"}}\u003C\u002Ftool_call>\"#;\nfor call in extract_tool_calls(ToolFormat::ChatMl, raw).into_iter().flatten() {\n    println!(\"call: {} -> {}\", call.name, call.arguments);\n}\n",[230,1053,1054,1059,1063,1068,1073,1078],{"__ignoreMap":258},[227,1055,1056],{"class":263,"line":264},[227,1057,1058],{},"use llama_crab::chat::tool_call::{extract_tool_calls, ToolFormat};\n",[227,1060,1061],{"class":263,"line":291},[227,1062,295],{"emptyLinePlaceholder":294},[227,1064,1065],{"class":263,"line":298},[227,1066,1067],{},"let raw = r#\"\u003Ctool_call>{\"name\":\"get_weather\",\"arguments\":{\"city\":\"Tokyo\"}}\u003C\u002Ftool_call>\"#;\n",[227,1069,1070],{"class":263,"line":304},[227,1071,1072],{},"for call in extract_tool_calls(ToolFormat::ChatMl, raw).into_iter().flatten() {\n",[227,1074,1075],{"class":263,"line":310},[227,1076,1077],{},"    println!(\"call: {} -> {}\", call.name, call.arguments);\n",[227,1079,1080],{"class":263,"line":316},[227,1081,1082],{},"}\n",[968,1084,1086],{"id":1085},"streaming-deltas-openai-style","Streaming deltas (OpenAI-style)",[253,1088,1090],{"className":255,"code":1089,"language":257,"meta":258,"style":258},"use llama_crab::chat::tool_call::{ToolCallStream, ToolFormat};\n\nlet mut stream = ToolCallStream::new(ToolFormat::ChatMl);\nlet mut deltas = Vec::new();\ndeltas.extend(stream.feed(\"\u003Ctool_call>\"));\ndeltas.extend(stream.feed(r#\"{\"name\":\"#));\ndeltas.extend(stream.feed(r#\"\"get_weather\"\"#));\ndeltas.extend(stream.feed(r#\",\"arguments\":{\"city\":\"Tokyo\"}}\"#));\ndeltas.extend(stream.feed(\"\u003C\u002Ftool_call>\"));\ndeltas.extend(stream.finish());\n\nfor d in deltas {\n    if let Some(id) = d.id { println!(\"id[{d.index}] = {id}\"); }\n    if let Some(name) = d.name { println!(\"name[{d.index}] = {name}\"); }\n    if let Some(args) = d.arguments { print!(\"args[{d.index}] += {args}\"); }\n    if let Some(call) = d.completed { println!(\"done[{}] = {}\", d.index, call.name); }\n}\n",[230,1091,1092,1097,1101,1106,1111,1116,1121,1126,1131,1136,1141,1145,1150,1155,1160,1165,1170],{"__ignoreMap":258},[227,1093,1094],{"class":263,"line":264},[227,1095,1096],{},"use llama_crab::chat::tool_call::{ToolCallStream, ToolFormat};\n",[227,1098,1099],{"class":263,"line":291},[227,1100,295],{"emptyLinePlaceholder":294},[227,1102,1103],{"class":263,"line":298},[227,1104,1105],{},"let mut stream = ToolCallStream::new(ToolFormat::ChatMl);\n",[227,1107,1108],{"class":263,"line":304},[227,1109,1110],{},"let mut deltas = Vec::new();\n",[227,1112,1113],{"class":263,"line":310},[227,1114,1115],{},"deltas.extend(stream.feed(\"\u003Ctool_call>\"));\n",[227,1117,1118],{"class":263,"line":316},[227,1119,1120],{},"deltas.extend(stream.feed(r#\"{\"name\":\"#));\n",[227,1122,1123],{"class":263,"line":322},[227,1124,1125],{},"deltas.extend(stream.feed(r#\"\"get_weather\"\"#));\n",[227,1127,1128],{"class":263,"line":328},[227,1129,1130],{},"deltas.extend(stream.feed(r#\",\"arguments\":{\"city\":\"Tokyo\"}}\"#));\n",[227,1132,1133],{"class":263,"line":333},[227,1134,1135],{},"deltas.extend(stream.feed(\"\u003C\u002Ftool_call>\"));\n",[227,1137,1138],{"class":263,"line":339},[227,1139,1140],{},"deltas.extend(stream.finish());\n",[227,1142,1143],{"class":263,"line":409},[227,1144,295],{"emptyLinePlaceholder":294},[227,1146,1147],{"class":263,"line":415},[227,1148,1149],{},"for d in deltas {\n",[227,1151,1152],{"class":263,"line":421},[227,1153,1154],{},"    if let Some(id) = d.id { println!(\"id[{d.index}] = {id}\"); }\n",[227,1156,1157],{"class":263,"line":427},[227,1158,1159],{},"    if let Some(name) = d.name { println!(\"name[{d.index}] = {name}\"); }\n",[227,1161,1162],{"class":263,"line":433},[227,1163,1164],{},"    if let Some(args) = d.arguments { print!(\"args[{d.index}] += {args}\"); }\n",[227,1166,1167],{"class":263,"line":439},[227,1168,1169],{},"    if let Some(call) = d.completed { println!(\"done[{}] = {}\", d.index, call.name); }\n",[227,1171,1172],{"class":263,"line":445},[227,1173,1082],{},[223,1175,1176,247,1179,1181,1182,1184,1185,1188,1189,1191,1192,1195,1196,241],{},[230,1177,1178],{},"extract_tool_calls",[230,1180,951],{}," live in\n",[230,1183,845],{},". The ",[230,1186,1187],{},"tools"," example in\n",[230,1190,717],{}," shows the full application loop: describe the tool\nin the system prompt, ask the model for a JSON call, parse the call, run\nthe function, and append a ",[230,1193,1194],{},"Role::Tool"," result message via\n",[230,1197,1198],{},"ChatMessage::tool_result(id, content)",[268,1200,1202],{"id":1201},"custom-jinja2-templates","Custom Jinja2 templates",[223,1204,1205,1208,1209,464,1212,247,1214,1217,1218,1221],{},[230,1206,1207],{},"chat::render_template"," evaluates a small but useful Jinja2 subset. The\ntemplate sees ",[230,1210,1211],{},"messages",[230,1213,1187],{},[230,1215,1216],{},"add_generation_prompt"," as\nimplicit variables. The supported features are documented in the\n",[230,1219,1220],{},"chat::template"," rustdoc; in short:",[1223,1224,1225,1267,1272,1277,1282,1289],"ul",{},[1226,1227,1228,1231,1232,1234,1235,1238,1239,464,1242,464,1245,464,1248,464,1251,464,1254,468,1257,464,1260,464,1263,1266],"li",{},[230,1229,1230],{},"{{ expr }}"," interpolation, attribute access via ",[230,1233,241],{}," or ",[230,1236,1237],{},"[\"key\"]",",\nfilters (",[230,1240,1241],{},"length",[230,1243,1244],{},"upper",[230,1246,1247],{},"lower",[230,1249,1250],{},"trim",[230,1252,1253],{},"default",[230,1255,1256],{},"tojson",[230,1258,1259],{},"string",[230,1261,1262],{},"int",[230,1264,1265],{},"abs",").",[1226,1268,1269,241],{},[230,1270,1271],{},"{% if cond %} ... {% elif %} ... {% else %} ... {% endif %}",[1226,1273,1274,241],{},[230,1275,1276],{},"{% for x in items %} ... {% endfor %}",[1226,1278,1279,241],{},[230,1280,1281],{},"{% set name = expr %}",[1226,1283,1284,1285,1288],{},"String, number, boolean, ",[230,1286,1287],{},"None",", list and dict literals.",[1226,1290,1291,1292,241],{},"Operators ",[230,1293,1294],{},"+ - * \u002F == != \u003C \u003C= > >= and or not in",[223,1296,1297,1298,1301,1302,468,1305,464,1308,464,1311,1314],{},"Unsupported features (returns ",[230,1299,1300],{},"TemplateError::Unsupported","): ",[230,1303,1304],{},"extends",[230,1306,1307],{},"include",[230,1309,1310],{},"macro",[230,1312,1313],{},"import",", custom filters, line statements.",[223,1316,1317,1318,1320],{},"If you need richer Jinja, fall back to a ",[230,1319,232],{}," or pre-render\nthe template outside the SDK.",[1322,1323,1324],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: