ssage, generate, then append the\nassistant reply:",[253,577,579],{"className":255,"code":578,"language":257,"meta":258,"style":258},"use llama_crab::chat::BuiltinTemplate;\nuse llama_crab::high_level::chat_completion::create_chat_completion_with;\nuse llama_crab::{ChatMessage, Llama, Role};\n\nlet mut history: Vec\u003CChatMessage> = Vec::new();\nhistory.push(ChatMessage::new(Role::System, \"You are a helpful assistant.\"));\nhistory.push(ChatMessage::new(Role::User, \"Hi!\"));\n\nlet response = create_chat_completion_with(\n    &mut llama,\n    &history,\n    BuiltinTemplate::ChatMl,\n    &[],\n    96,\n)?;\nhistory.push(ChatMessage::new(Role::Assistant, response.content));\n\n\u002F\u002F Next turn:\nhistory.push(ChatMessage::new(Role::User, \"Tell me a joke.\"));\nlet response = create_chat_completion_with(\n    &mut llama,\n    &history,\n    BuiltinTemplate::ChatMl,\n    &[],\n    96,\n)?;\nhistory.push(ChatMessage::new(Role::Assistant, response.content));\n",[230,580,581,585,589,594,598,603,608,613,617,621,625,630,634,639,644,648,653,657,662,668,673,678,683,688,693,698,703],{"__ignoreMap":258},[227,582,583],{"class":263,"line":264},[227,584,367],{},[227,586,587],{"class":263,"line":291},[227,588,372],{},[227,590,591],{"class":263,"line":298},[227,592,593],{},"use llama_crab::{ChatMessage, Llama, Role};\n",[227,595,596],{"class":263,"line":304},[227,597,295],{"emptyLinePlaceholder":294},[227,599,600],{"class":263,"line":310},[227,601,602],{},"let mut history: Vec\u003CChatMessage> = Vec::new();\n",[227,604,605],{"class":263,"line":316},[227,606,607],{},"history.push(ChatMessage::new(Role::System, \"You are a helpful assistant.\"));\n",[227,609,610],{"class":263,"line":322},[227,611,612],{},"history.push(ChatMessage::new(Role::User, \"Hi!\"));\n",[227,614,615],{"class":263,"line":328},[227,616,295],{"emptyLinePlaceholder":294},[227,618,619],{"class":263,"line":333},[227,620,412],{},[227,622,623],{"class":263,"line":339},[227,624,418],{},[227,626,627],{"class":2