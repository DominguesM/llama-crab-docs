],{"class":244,"line":282},7,[242,284,285],{},")?;\n",[242,287,289],{"class":244,"line":288},8,[242,290,255],{"emptyLinePlaceholder":254},[242,292,294],{"class":244,"line":293},9,[242,295,296],{},"let embedding = llama.embed(\"Rust is a systems programming language.\", true)?;\n",[242,298,300],{"class":244,"line":299},10,[242,301,302],{},"println!(\"dim = {}\", embedding.len());\n",[223,304,305,306,309],{},"The ",[239,307,308],{},"Llama::embed"," helper:",[311,312,313,317,324,331,337],"ol",{},[314,315,316],"li",{},"Clears sequence 0 of the KV cache.",[314,318,319,320,323],{},"Tokenizes the text with ",[239,321,322],{},"add_bos = true, special = false",".",[314,325,326,327,330],{},"Builds a ",[239,328,329],{},"LlamaBatch",", requests embeddings for every token, and\nencodes the batch.",[314,332,333,334,323],{},"Reads the sequence-level embedding via ",[239,335,336],{},"LlamaContext::embeddings_seq(0)",[314,338,339],{},"Optionally L2-normalizes the returned vector in place.",[223,341,342,343,346,347,350,351,354],{},"The second argument controls L2 normalization. Pass ",[239,344,345],{},"false"," to receive\nthe raw vector and call ",[239,348,349],{},"LlamaContext::normalize(&mut v)"," yourself\n(equivalently ",[239,352,353],{},"LlamaContextParams::l2_normalize(&mut v)",", both are\npublic associated functions on their respective types).",[227,356,358],{"id":357},"lower-level-access","Lower-level access",[223,360,361,362,365],{},"For per-token embeddings or non-normalized vectors, drop down to\n",[239,363,364],{},"LlamaContext",":",[232,367,369],{"className":234,"code":368,"language":236,"meta":237,"style":237},"use llama_crab::context::params::PoolingType;\nuse llama_crab::{Llama, LlamaParams};\n\nlet mut llama = Llama::load(\n    LlamaParams::new(\"models\u002Fbge-small-en-v1.5-q4_k_m.gguf\")\n        .with_n_ctx(512)\n        .with_embeddings(true)\n        .with_pooling_type(PoolingType::Cls),\n)?;\n\n\u002F\u002F After encoding, the context exposes:\n\u002F\u002F   - embeddings()        -> last sequence\n\u002F\u002F   - embeddings_seq(id)  -> a specific sequence\n\u002F\u002F   - embeddings_ith(i)   -> a specific token in the last batch\nlet emb: &[f32] = llama.context().embeddings_seq(0)?;\n",[239,370,371,376,380,384,388,392,396,401,406,410,414,420,426,432,438],{"__ignoreMap":237},[242,372,373],{"class":244,"line":245},[242,374,375],{},"use llama_crab::context::params::PoolingType;\n",[242,377,378],{"class":244,"line":251},[242,379,248],{},[242,381,382],{"class":244,"line":258},[242,383,255],{"emptyLinePlaceholder":254},[242,385,386],{"class":244,"line":264},[242,387,261],{},[242,389,390],{"class":244,"line":270},[242,391,267],{},[242,393,394],{"class":244,"line":276},[242,395,273],{},[242,397,398],{"class":244,"line":282},[242,399,400],{},"        .with_embeddings(true)\n",[242,402,403],{"class":244,"line":288},[242,404,405],{},"        .with_pooling_type(PoolingType::Cls),\n",[242,407,408],{"class":244,"line":293},[242,409,285],{},[242,411,412],{"class":244,"line":299},[242,413,255],{"emptyLinePlaceholder":254},[242,415,417],{"class":244,"line":416},11,[242,418,419],{},"\u002F\u002F After encoding, the context exposes:\n",[242,421,423],{"class":244,"line":422},12,[242,424,425],{},"\u002F\u002F   - embeddings()        -> last sequence\n",[242,427,429],{"class":244,"line":428},13,[242,430,431],{},"\u002F\u002F   - embeddings_seq(id)  -> a specific sequence\n",[242,433,435],{"class":244,"line":434},14,[242,436,437],{},"\u002F\u002F   - embeddings_ith(i)   -> a specific token in the last batch\n",[242,439,441],{"class":244,"line":440},15,[242,442,443],{},"let emb: &[f32] = llama.context().embeddings_seq(0)?;\n",[223,445,446,449,450,453,454,457,458,461,462,457,465,468,469,472],{},[239,447,448],{},"PoolingType"," covers ",[239,451,452],{},"Unspecified"," (use the model's default), ",[239,455,456],{},"None",", ",[239,459,460],{},"Mean",",\n",[239,463,464],{},"Cls",[239,466,467],{},"Last"," and ",[239,470,471],{},"Rank"," (the value reranker GGUFs declare).",[227,474,476],{"id":475},"batched-embeddings-with-token-accounting","Batched embeddings with token accounting",[223,478,479,482,483,485,486,489],{},[239,480,481],{},"Llama::embed_texts(texts, normalize)"," is a thin convenience around\n",[239,484,308],{}," that returns an ",[239,487,488],{},"EmbeddingBatch"," with the per-batch token\ncount:",[232,491,493],{"className":234,"code":492,"language":236,"meta":237,"style":237},"use llama_crab::{Llama, LlamaParams};\n\nlet mut llama = Llama::load(\n    LlamaParams::new(\"models\u002Fbge-small-en-v1.5-q4_k_m.gguf\")\n        .with_n_ctx(512)\n        .with_embeddings(true),\n)?;\n\nlet docs = vec![\n    \"Rust is a systems programming language.\".to_string(),\n    \"Python is dynamically typed.\".to_string(),\n    \"Go has goroutines.\".to_string(),\n];\nlet batch = llama.embed_texts(&docs, \u002F* normalize *\u002F true)?;\nfor (text, vector) in docs.iter().zip(batch.vectors.iter()) {\n    println!(\"{text} -> dim {}\", vector.len());\n}\nprintln!(\"prompt_tokens: {}\", batch.prompt_tokens);\n",[239,494,495,499,503,507,511,515,519,523,527,532,537,542,547,552,557,562,568,574],{"__ignoreMap":237},[242,496,497],{"class":244,"line":245},[242,498,248],{},[242,500,501],{"class":244,"line":251},[242,502,255],{"emptyLinePlaceholder":254},[242,504,505],{"class":244,"line":258},[242,506,261],{},[242,508,509],{"class":244,"line":264},[242,510,267],{},[242,512,513],{"class":244,"line":270},[242,514,273],{},[242,516,517],{"class":244,"line":276},[242,518,279],{},[242,520,521],{"class":244,"line":282},[242,522,285],{},[242,524,525],{"class":244,"line":288},[242,526,255],{"emptyLinePlaceholder":254},[242,528,529],{"class":244,"line":293},[242,530,531],{},"let docs = vec![\n",[242,533,534],{"class":244,"line":299},[242,535,536],{},"    \"Rust is a systems programming language.\".to_string(),\n",[242,538,539],{"class":244,"line":416},[242,540,541],{},"    \"Python is dynamically typed.\".to_string(),\n",[242,543,544],{"class":244,"line":422},[242,545,546],{},"    \"Go has goroutines.\".to_string(),\n",[242,548,549],{"class":244,"line":428},[242,550,551],{},"];\n",[242,553,554],{"class":244,"line":434},[242,555,556],{},"let batch = llama.embed_texts(&docs, \u002F* normalize *\u002F true)?;\n",[242,558,559],{"class":244,"line":440},[242,560,561],{},"for (text, vector) in docs.iter().zip(batch.vectors.iter()) {\n",[242,563,565],{"class":244,"line":564},16,[242,566,567],{},"    println!(\"{text} -> dim {}\", vector.len());\n",[242,569,571],{"class":244,"line":570},17,[242,572,573],{},"}\n",[242,575,577],{"class":244,"line":576},18,[242,578,579],{},"println!(\"prompt_tokens: {}\", batch.prompt_tokens);\n",[227,581,583],{"id":582},"similarity-search","Similarity search",[223,585,586],{},"Compute one query embedding, embed your corpus, and sort by cosine\nsimilarity. For normalized vectors, cosine similarity is the dot\nproduct. If you request raw vectors, divide by both vector norms.",[227,588,590],{"id":589},"reranking","Reranking",[223,592,593,596,597,600,601,604,605,608,609,611],{},[239,594,595],{},"Llama::rerank(query, documents)"," is a cross-encoder driver that scores\neach ",[239,598,599],{},"(query, document)"," pair. The model must have been trained with\n",[239,602,603],{},"pooling_type = Rank"," (a reranker GGUF will declare it). Each pair is\nencoded in a separate forward pass — simple and correct, even if not the\nmost efficient. For a batched implementation, use the ",[239,606,607],{},"seq_*"," methods\non ",[239,610,364],{}," directly.",[232,613,615],{"className":234,"code":614,"language":236,"meta":237,"style":237},"use llama_crab::{Llama, LlamaParams};\n\nlet mut llama = Llama::load(\n    LlamaParams::new(\"models\u002Fbge-reranker-v2-m3-q4_k_m.gguf\")\n        .with_n_ctx(512)\n        .with_embeddings(true),\n)?;\n\nlet query = \"What is the capital of France?\";\nlet docs = &[\n    \"Paris is the capital and most populous city of France.\",\n    \"Berlin is the capital of Germany.\",\n    \"Madrid is the capital of Spain.\",\n];\n\nlet scores = llama.rerank(query, docs)?;\n\u002F\u002F Higher score = more relevant.\nlet mut ranked: Vec\u003C(usize, f32)> = scores.iter().copied().enumerate().collect();\nranked.sort_by(|a, b| b.1.total_cmp(&a.1));\nfor (idx, score) in ranked {\n    println!(\"{score:+.4}  {}\", docs[idx]);\n}\n",[239,616,617,621,625,629,634,638,642,646,650,655,660,665,670,675,679,683,688,693,698,704,710,716],{"__ignoreMap":237},[242,618,619],{"class":244,"line":245},[242,620,248],{},[242,622,623],{"class":244,"line":251},[242,624,255],{"emptyLinePlaceholder":254},[242,626,627],{"class":244,"line":258},[242,628,261],{},[242,630,631],{"class":244,"line":264},[242,632,633],{},"    LlamaParams::new(\"models\u002Fbge-reranker-v2-m3-q4_k_m.gguf\")\n",[242,635,636],{"class":244,"line":270},[242,637,273],{},[242,639,640],{"class":244,"line":276},[242,641,279],{},[242,643,644],{"class":244,"line":282},[242,645,285],{},[242,647,648],{"class":244,"line":288},[242,649,255],{"emptyLinePlaceholder":254},[242,651,652],{"class":244,"line":293},[242,653,654],{},"let query = \"What is the capital of France?\";\n",[242,656,657],{"class":244,"line":299},[242,658,659],{},"let docs = &[\n",[242,661,662],{"class":244,"line":416},[242,663,664],{},"    \"Paris is the capital and most populous city of France.\",\n",[242,666,667],{"class":244,"line":422},[242,668,669],{},"    \"Berlin is the capital of Germany.\",\n",[242,671,672],{"class":244,"line":428},[242,673,674],{},"    \"Madrid is the capital of Spain.\",\n",[242,676,677],{"class":244,"line":434},[242,678,551],{},[242,680,681],{"class":244,"line":440},[242,682,255],{"emptyLinePlaceholder":254},[242,684,685],{"class":244,"line":564},[242,686,687],{},"let scores = llama.rerank(query, docs)?;\n",[242,689,690],{"class":244,"line":570},[242,691,692],{},"\u002F\u002F Higher score = more relevant.\n",[242,694,695],{"class":244,"line":576},[242,696,697],{},"let mut ranked: Vec\