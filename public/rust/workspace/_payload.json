or sampler chains (17 strategies).",[652,736,737,740],{},[226,738,739],{},"chat"," for templates, roles, tool definitions, the streaming tool-call\nparser and the Jinja2-subset renderer.",[652,742,743,746,747,749,750,752],{},[226,744,745],{},"multimodal"," for ",[226,748,236],{}," image\u002Faudio\u002Fprojector handling (behind the\n",[226,751,236],{}," feature).",[652,754,755,758],{},[226,756,757],{},"json_schema"," for converting JSON Schema 2020-12 to GBNF.",[652,760,761,764,765,768],{},[226,762,763],{},"speculative"," for prompt-lookup n-gram speculative decoding and a\n",[226,766,767],{},"DraftModel"," trait for custom draft strategies.",[254,770,772],{"id":771},"minimum-supported-rust-version","Minimum supported Rust version",[223,774,775,776,779,780,783,784,787],{},"The workspace pins ",[226,777,778],{},"rust-version = \"1.88\""," (recorded in\n",[226,781,782],{},"rust-toolchain.toml"," and the workspace ",[226,785,786],{},"[workspace.package]"," block). CI and\nrelease workflows use this channel.",[223,789,790,791,793,794,797],{},"Repository layout and build profiles are documented in\n",[242,792,201],{"href":202},". Runnable examples live in the\nseparate ",[226,795,796],{},"llama-crab-examples"," repository.",{"title":799,"searchDepth":800,"depth":800,"links":801},"",2,[802,803,804,805,806],{"id":256,"depth":800,"text":257},{"id":353,"depth":800,"text":354},{"id":389,"depth":800,"text":390},{"id":643,"depth":800,"text":644},{"id":771,"depth":800,"text":772},"Map the Rust and TypeScript packages that make up llama-crab.","md",null,{},{"icon":45},{"title":42,"description":807},"VzMhCOR9Le4eICffML3FniJXqkjwxUxFItIhtYpShH4",[815,817],{"title":30,"path":31,"stem":32,"description":816,"icon":33,"children":-1},"Select llama-crab compute backends with Cargo features.",{"title":47,"path":48,"stem":49,"description":818,"icon":50,"children":-1},"Load, inspect, and reuse llama-crab models safely in Rust applications.",1781622520533]