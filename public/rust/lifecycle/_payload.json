ript\u002Fupdate_notes","5.typescript\u002FUPDATE_NOTES",{"title":144,"icon":145,"path":146,"stem":147,"children":148,"page":34},"Guides","i-lucide-compass","\u002Fguides","6.guides",[149,154,159],{"title":150,"path":151,"stem":152,"icon":153},"Performance","\u002Fguides\u002Fperformance","6.guides\u002F1.performance","i-lucide-gauge",{"title":155,"path":156,"stem":157,"icon":158},"Mobile","\u002Fguides\u002Fmobile","6.guides\u002F2.mobile","i-lucide-smartphone",{"title":160,"path":161,"stem":162,"icon":163},"Troubleshooting Models","\u002Fguides\u002Ftroubleshooting-models","6.guides\u002F3.troubleshooting-models","i-lucide-wrench",{"title":165,"icon":166,"path":167,"stem":168,"children":169,"page":34},"Reference","i-lucide-book-marked","\u002Freference","7.reference",[170,175,180],{"title":171,"path":172,"stem":173,"icon":174},"Crates and packages","\u002Freference\u002Fcrates","7.reference\u002F1.crates","i-lucide-boxes",{"title":176,"path":177,"stem":178,"icon":179},"Cargo features","\u002Freference\u002Fcargo-features","7.reference\u002F2.cargo-features","i-lucide-toggle-right",{"title":181,"path":182,"stem":183,"icon":184},"Versioning","\u002Freference\u002Fversioning","7.reference\u002F3.versioning","i-lucide-git-branch",{"title":186,"icon":187,"path":188,"stem":189,"children":190,"page":34},"Examples","i-lucide-flask-conical","\u002Fexamples","8.examples",[191],{"title":186,"path":192,"stem":193,"icon":187},"\u002Fexamples\u002Fexamples","8.examples\u002F1.examples",{"title":195,"icon":196,"path":197,"stem":198,"children":199,"page":34},"Contributing","i-lucide-git-pull-request-arrow","\u002Fcontributing","9.contributing",[200,204,207],{"title":201,"path":202,"stem":203,"icon":37},"Development","\u002Fcontributing\u002Fdevelopment","9.contributing\u002F1.development",{"title":186,"path":205,"stem":206,"icon":187},"\u002Fcontributing\u002Fexamples","9.contributing\u002F2.examples",{"title":208,"path":209,"stem":210,"icon":211},"Releases","\u002Fcontributing\u002Freleases","9.contributing\u002F3.releases","i-lucide-rocket",{"title":213,"path":214,"stem":215,"icon":216},"Troubleshooting","\u002Ftroubleshooting","troubleshooting","i-lucide-life-buoy",{"id":218,"title":47,"body":219,"description":965,"extension":966,"links":967,"meta":968,"navigation":969,"path":48,"seo":970,"stem":49,"__hash__":971},"docs\u002F2.rust\u002F2.lifecycle.md",{"type":220,"value":221,"toc":955},"minimark",[222,234,239,305,319,355,374,381,391,620,643,647,652,681,706,710,716,756,789,793,798,826,840,844,860,877,907,911,951],[223,224,225,226,230,231,233],"p",{},"The high-level ",[227,228,229],"code",{},"Llama"," type owns the llama.cpp backend, loaded model, and active\ncontext. In most applications you load one ",[227,232,229],{}," per model and keep it alive\nfor the lifetime of the worker that serves requests.",[235,236,238],"h2",{"id":237},"load","Load",[240,241,246],"pre",{"className":242,"code":243,"language":244,"meta":245,"style":245},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use llama_crab::{Llama, LlamaParams};\n\nlet mut llama = Llama::load(\n    LlamaParams::new(\"models\u002Fqwen2.5-0.5b-instruct-q4_k_m.gguf\")\n        .with_n_ctx(2048)\n        .with_n_batch(512)\n        .with_n_threads(4)\n        .with_n_gpu_layers(0),\n)?;\n","rust","",[227,247,248,256,263,269,275,281,287,293,299],{"__ignoreMap":245},[249,250,253],"span",{"class":251,"line":252},"line",1,[249,254,255],{},"use llama_crab::{Llama, LlamaParams};\n",[249,257,259],{"class":251,"line":258},2,[249,260,262],{"emptyLinePlaceholder":261},true,"\n",[249,264,266],{"class":251,"line":265},3,[249,267,268],{},"let mut llama = Llama::load(\n",[249,270,272],{"class":251,"line":271},4,[249,273,274],{},"    LlamaParams::new(\"models\u002Fqwen2.5-0.5b-instruct-q4_k_m.gguf\")\n",[249,276,278],{"class":251,"line":277},5,[249,279,280],{},"        .with_n_ctx(2048)\n",[249,282,284],{"class":251,"line":283},6,[249,285,286],{},"        .with_n_batch(512)\n",[249,288,290],{"class":251,"line":289},7,[249,291,292],{},"        .with_n_threads(4)\n",[249,294,296],{"class":251,"line":295},8,[249,297,298],{},"        .with_n_gpu_layers(0),\n",[249,300,302],{"class":251,"line":301},9,[249,303,304],{},")?;\n",[223,306,307,310,311,314,315,318],{},[227,308,309],{},"Llama::load"," also accepts a Hugging Face repo id. When the path looks like\n",[227,312,313],{},"org\u002Frepo"," and the local file does not exist, the resolver (gated on the\n",[227,316,317],{},"hf-hub"," cargo feature) downloads the GGUF to the HF cache and then loads it:",[240,320,322],{"className":242,"code":321,"language":244,"meta":245,"style":245},"use llama_crab::{Llama, LlamaParams};\n\nlet mut llama = Llama::load(\n    LlamaParams::new(\"TheBloke\u002FLlama-2-7B-Chat-GGUF\")\n        .with_hf_filename(\"llama-2-7b-chat.Q4_K_M.gguf\")\n        .with_n_ctx(2048),\n)?;\n",[227,323,324,328,332,336,341,346,351],{"__ignoreMap":245},[249,325,326],{"class":251,"line":252},[249,327,255],{},[249,329,330],{"class":251,"line":258},[249,331,262],{"emptyLinePlaceholder":261},[249,333,334],{"class":251,"line":265},[249,335,268],{},[249,337,338],{"class":251,"line":271},[249,339,340],{},"    LlamaParams::new(\"TheBloke\u002FLlama-2-7B-Chat-GGUF\")\n",[249,342,343],{"class":251,"line":277},[249,344,345],{},"        .with_hf_filename(\"llama-2-7b-chat.Q4_K_M.gguf\")\n",[249,347,348],{"class":251,"line":283},[249,349,350],{},"        .with_n_ctx(2048),\n",[249,352,353],{"class":251,"line":289},[249,354,304],{},[223,356,357,358,361,362,365,366,369,370,373],{},"The cache lives at ",[227,359,360],{},"~\u002F.cache\u002Fhuggingface\u002Fhub"," (or ",[227,363,364],{},"$HF_HOME\u002Fhub"," if set), and\n",[227,367,368],{},"HF_TOKEN"," works for gated repos. The resolver precedence is documented in\nthe crate-level rustdoc of ",[227,371,372],{},"llama-crab",".",[235,375,377,380],{"id":376},"llamaparams-setters",[227,378,379],{},"LlamaParams"," setters",[223,382,383,384,387,388,390],{},"Useful parameters (each is a chainable ",[227,385,386],{},"with_*"," method on ",[227,389,379],{},"):",[392,393,394,407],"table",{},[395,396,397],"thead",{},[398,399,400,404],"tr",{},[401,402,403],"th",{},"Setter",[401,405,406],{},"Effect",[408,409,410,421,431,441,451,461,471,485,495,505,515,525,556,566,576,586,596,606],"tbody",{},[398,411,412,418],{},[413,414,415],"td",{},[227,416,417],{},"with_model_path(path)",[413,419,420],{},"Replace the GGUF path.",[398,422,423,428],{},[413,424,425],{},[227,426,427],{},"with_n_ctx(n)",[413,429,430],{},"Maximum context window for prompt plus generated tokens.",[398,432,433,438],{},[413,434,435],{},[227,436,437],{},"with_n_batch(n)",[413,439,440],{},"Logical maximum batch size.",[398,442,443,448],{},[413,444,445],{},[227,446,447],{},"with_n_ubatch(n)",[413,449,450],{},"Physical batch size used by forward passes.",[398,452,453,458],{},[413,454,455],{},[227,456,457],{},"with_n_threads(n)",[413,459,460],{},"CPU threads for generation.",[398,462,463,468],{},[413,464,465],{},[227,466,467],{},"with_n_threads_batch(n)",[413,469,470],{},"CPU threads for batch work.",[398,472,473,478],{},[413,474,475],{},[227,476,477],{},"with_n_gpu_layers(n)",[413,479,480,481,484],{},"Number of model layers to offload to the active GPU backend. ",[227,482,483],{},"-1"," offloads every layer.",[398,486,487,492],{},[413,488,489],{},[227,490,491],{},"with_use_mmap(yes)",[413,493,494],{},"Memory-map the GGUF file.",[398,496,497,502],{},[413,498,499],{},[227,500,501],{},"with_offload_kqv(yes)",[413,503,504],{},"Offload the KQV cache to the active GPU backend.",[398,506,507,512],{},[413,508,509],{},[227,510,511],{},"with_flash_attn(yes)",[413,513,514],{},"Enable flash attention when supported.",[398,516,517,522],{},[413,518,519],{},[227,520,521],{},"with_embeddings(yes)",[413,523,524],{},"Enable embedding extraction on the context.",[398,526,527,532],{},[413,528,529],{},[227,530,531],{},"with_pooling_type(t)",[413,533,534,535,538,539,538,542,538,545,538,548,551,552,555],{},"Select embedding pooling (",[227,536,537],{},"PoolingType::Cls",", ",[227,540,541],{},"Mean",[227,543,544],{},"Last",[227,546,547],{},"Rank",[227,549,550],{},"None",", or ",[227,553,554],{},"Unspecified",").",[398,557,558,563],{},[413,559,560],{},[227,561,562],{},"with_hf_filename(name)",[413,564,565],{},"Set the filename within a Hugging Face repo.",[398,567,568,573],{},[413,569,570],{},[227,571,572],{},"with_hf_revision(rev)",[413,574,575],{},"Pin the HF revision (branch\u002Ftag\u002Fcommit).",[398,577,578,583],{},[413,579,580],{},[227,581,582],{},"with_hf_token(token)",[413,584,585],{},"Hugging Face access token.",[398,587,588,593],{},[413,589,590],{},[227,591,592],{},"with_hf_cache_dir(dir)",[413,594,595],{},"Override the HF cache directory.",[398,597,598,603],{},[413,599,600],{},[227,601,602],{},"with_hf_endpoint(url)",[413,604,605],{},"Point at an HF mirror.",[398,607,608,613],{},[413,609,610],{},[227,611,612],{},"with_mobile_preset(preset)",[413,614,615,616,619],{},"Apply a ",[227,617,618],{},"MobilePreset"," (see below).",[223,621,622,623,625,626,629,630,633,634,629,637,640,641,373],{},"The model-side and context-side parameters that ",[227,624,379],{}," wraps\n(",[227,627,628],{},"LlamaModelParams"," and ",[227,631,632],{},"LlamaContextParams",") are also exposed via\n",[227,635,636],{},"llama.model()",[227,638,639],{},"llama.context()",", so lower-level modules can be used\nwithout going through ",[227,642,379],{},[235,644,646],{"id":645},"mobile-presets","Mobile presets",[223,648,649,651],{},[227,650,618],{}," provides coarse defaults for device classes. The preset is\napplied first, then any explicit setter you call after overrides individual\nfields:",[240,653,655],{"className":242,"code":654,"language":244,"meta":245,"style":245},"use llama_crab::{LlamaParams, MobilePreset};\n\nlet params = LlamaParams::new(\"models\u002Fmodel.gguf\")\n    .with_mobile_preset(MobilePreset::Balanced)\n    .with_n_ctx(1024); \u002F\u002F overrides the preset's n_ctx\n",[227,656,657,662,666,671,676],{"__ignoreMap":245},[249,658,659],{"class":251,"line":252},[249,660,661],{},"use llama_crab::{LlamaParams, MobilePreset};\n",[249,663,664],{"class":251,"line":258},[249,665,262],{"emptyLinePlaceholder":261},[249,667,668],{"class":251,"line":265},[249,669,670],{},"let params = LlamaParams::new(\"models\u002Fmodel.gguf\")\n",[249,672,673],{"class":251,"line":271},[249,674,675],{},"    .with_mobile_preset(MobilePreset::Balanced)\n",[249,677,678],{"class":251,"line":277},[249,679,680],{},"    .with_n_ctx(1024); \u002F\u002F overrides the preset's n_ctx\n",[223,682,683,684,538,687,690,691,694,695,538,698,701,702,705],{},"Available presets are ",[227,685,686],{},"LowRam",[227,688,689],{},"Balanced",", and ",[227,692,693],{},"GpuMax",". The same names are\naccepted by the server CLI as ",[227,696,697],{},"--mobile-preset low-ram",[227,699,700],{},"balanced",", or\n",[227,703,704],{},"gpu-max"," (parsing is case-insensitive and hyphen\u002Funderscore tolerant).",[235,707,709],{"id":708},"inspect-the-model","Inspect the model",[223,711,712,713,715],{},"After loading, ",[227,714,636],{}," exposes metadata and tokenization helpers:",[240,717,719],{"className":242,"code":718,"language":244,"meta":245,"style":245},"let tokens = llama.model().tokenize(\"Hello from Rust\", true, true)?;\nprintln!(\"layers:   {}\", llama.model().n_layer());\nprintln!(\"vocab:    {}\", llama.model().n_vocab());\nprintln!(\"embd:     {}\", llama.model().n_embd());\nprintln!(\"params:   {}\", llama.model().n_params());\nprintln!(\"size:     {}\", llama.model().size());\nprintln!(\"tokens:   {tokens:?}\");\n",[227,720,721,726,731,736,741,746,751],{"__ignoreMap":245},[249,722,723],{"class":251,"line":252},[249,724,725],{},"let tokens = llama.model().tokenize(\"Hello from Rust\", true, true)?;\n",[249,727,728],{"class":251,"line":258},[249,729,730],{},"println!(\"layers:   {}\", llama.model().n_layer());\n",[249,732,733],{"class":251,"line":265},[249,734,735],{},"println!(\"vocab:    {}\", llama.model().n_vocab());\n",[249,737,738],{"class":251,"line":271},[249,739,740],{},"println!(\"embd:     {}\", llama.model().n_embd());\n",[249,742,743],{"class":251,"line":277},[249,744,745],{},"println!(\"params:   {}\", llama.model().n_params());\n",[249,747,748],{"class":251,"line":283},[249,749,750],{},"println!(\"size:     {}\", llama.model().size());\n",[249,752,753],{"class":251,"line":289},[249,754,755],{},"println!(\"tokens:   {tokens:?}\");\n",[223,757,758,761,762,765,766,765,769,772,773,776,777,780,781,785,786,373],{},[227,759,760],{},"LlamaModel"," also exposes ",[227,763,764],{},"token_bos"," \u002F ",[227,767,768],{},"token_eos",[227,770,771],{},"token_eot"," and a\nFIM token accessor through ",[227,774,775],{},"LlamaModel::fim_tokens()",". ",[227,778,779],{},"detokenize"," uses\n",[782,783,784],"strong",{},"lossy"," UTF-8 conversion: bytes that do not form a valid UTF-8 sequence\non their own (common for BPE tokens) are replaced with ",[227,787,788],{},"U+FFFD",[235,790,792],{"id":791},"hugging-face-paths","Hugging Face paths",[223,794,795,797],{},[227,796,309],{}," distinguishes the four cases by inspecting the path string and\nthe file system:",[799,800,801,808,817,820],"ol",{},[802,803,804,807],"li",{},[227,805,806],{},"with_hf_filename"," on a path that already parses as a repo id — the\nresolver forces the HF branch (override wins).",[802,809,810,813,814,816],{},[227,811,812],{},"model_path"," looks like ",[227,815,313],{}," and the file does not exist on disk —\nauto-dispatch to the HF downloader.",[802,818,819],{},"The path exists on disk — load it directly with no network access.",[802,821,822,823,825],{},"The path does not exist and is not a repo id — ",[227,824,309],{}," returns an\nIO error from llama.cpp.",[223,827,828,829,832,833,835,836,839],{},"Under ",[227,830,831],{},"--no-default-features"," (or without the ",[227,834,317],{}," feature) the HF\ndispatcher returns a runtime error pointing at the ",[227,837,838],{},"--features hf-hub"," build\nflag instead of attempting a download.",[235,841,843],{"id":842},"reuse-swap-and-concurrency","Reuse, swap, and concurrency",[223,845,846,847,538,850,538,853,538,856,859],{},"Generation updates the context KV cache. The high-level helpers\n(",[227,848,849],{},"create_completion",[227,851,852],{},"embed",[227,854,855],{},"rerank",[227,857,858],{},"complete_infill",") clear\nsequence 0 before each call so each invocation is independent.",[223,861,862,863,866,867,870,871,873,874,876],{},"If you want a long-running multi-turn state, hold a ",[227,864,865],{},"Vec\u003CChatMessage>"," in\nyour own state and rebuild the prompt for every call — see\n",[868,869,57],"a",{"href":58}," for the pattern. For long-lived single-shot services\nwith multiple concurrent requests, use a worker model: Axum (or any runtime)\nserializes requests per loaded ",[227,872,229],{},", or you load multiple ",[227,875,229],{},"\ninstances.",[223,878,879,881,882,765,885,888,889,892,893,896,897,629,900,902,903,906],{},[227,880,229],{}," is ",[227,883,884],{},"!Send",[227,886,887],{},"!Sync"," (it carries a ",[227,890,891],{},"PhantomData\u003C*mut ()>"," marker\nto mirror llama.cpp's thread model — see ",[227,894,895],{},"src\u002Fhigh_level\u002Fmod.rs","). The\ninner ",[227,898,899],{},"LlamaContext",[227,901,760],{}," types are explicitly ",[227,904,905],{},"Send + Sync",",\nso they can be moved across threads if you drive them by hand.",[235,908,910],{"id":909},"closing-the-model","Closing the model",[223,912,913,914,917,918,920,921,924,925,928,929,690,932,920,935,937,938,941,942,944,945,947,948,373],{},"There is no explicit ",[227,915,916],{},"unload"," — ",[227,919,229],{},"'s ",[227,922,923],{},"Drop"," impl frees the\n",[227,926,927],{},"llama_context"," and then the ",[227,930,931],{},"llama_model",[227,933,934],{},"LlamaBackend",[227,936,923],{},"\ncalls ",[227,939,940],{},"llama_backend_free",". Drop the ",[227,943,229],{}," value (or its containing\nworker) and the resources are released. To swap models, drop the current\n",[227,946,229],{}," and create a new one with ",[227,949,950],{},"Llama::load(...)",[952,953,954],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":245,"searchDepth":258,"depth":258,"links":956},[957,958,960,961,962,963,964],{"id":237,"depth":258,"text":238},{"id":376,"depth":258,"text":959},"LlamaParams setters",{"id":645,"depth":258,"text":646},{"id":708,"depth":258,"text":709},{"id":791,"depth":258,"text":792},{"id":842,"depth":258,"text":843},{"id":909,"depth":258,"text":910},"Load, inspect, and reuse llama-crab models safely in Rust applications.","md",null,{}