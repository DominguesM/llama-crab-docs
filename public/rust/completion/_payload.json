\u002Freleases","9.contributing\u002F3.releases","i-lucide-rocket",{"title":213,"path":214,"stem":215,"icon":216},"Troubleshooting","\u002Ftroubleshooting","troubleshooting","i-lucide-life-buoy",{"id":218,"title":52,"body":219,"description":918,"extension":919,"links":920,"meta":921,"navigation":922,"path":53,"seo":923,"stem":54,"__hash__":924},"docs\u002F2.rust\u002F3.completion.md",{"type":220,"value":221,"toc":911},"minimark",[222,231,236,278,292,324,328,335,415,454,519,522,529,607,638,642,651,793,860,864,895,907],[223,224,225,226,230],"p",{},"Use text completion when you already have the exact prompt string you want to\nsend to the model. The high-level driver lives in\n",[227,228,229],"code",{},"llama_crab::high_level::completion"," and is re-exported from the crate root.",[232,233,235],"h2",{"id":234},"minimal-completion","Minimal completion",[237,238,243],"pre",{"className":239,"code":240,"language":241,"meta":242,"style":242},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use llama_crab::{Llama, LlamaParams};\n\nlet mut llama = Llama::load(LlamaParams::new(\"models\u002Fmodel.gguf\").with_n_ctx(512))?;\nlet response = llama.create_completion(\"Once upon a time\", 64)?;\nprintln!(\"{}\", response.text);\n","rust","",[227,244,245,253,260,266,272],{"__ignoreMap":242},[246,247,250],"span",{"class":248,"line":249},"line",1,[246,251,252],{},"use llama_crab::{Llama, LlamaParams};\n",[246,254,256],{"class":248,"line":255},2,[246,257,259],{"emptyLinePlaceholder":258},true,"\n",[246,261,263],{"class":248,"line":262},3,[246,264,265],{},"let mut llama = Llama::load(LlamaParams::new(\"models\u002Fmodel.gguf\").with_n_ctx(512))?;\n",[246,267,269],{"class":248,"line":268},4,[246,270,271],{},"let response = llama.create_completion(\"Once upon a time\", 64)?;\n",[246,273,275],{"class":248,"line":274},5,[246,276,277],{},"println!(\"{}\", response.text);\n",[223,279,280,283,284,287,288,291],{},[227,281,282],{},"create_completion"," clears sequence 0 of the KV cache before each call, so\ntwo consecutive calls do not share prompt state. This mirrors the ",[227,285,286],{},"simple","\nexample in the ",[227,289,290],{},"llama-crab-examples"," repository.",[223,293,294,297,298,303,304,307,308,307,311,307,314,317,318,323],{},[227,295,296],{},"Completion"," carries the concatenated text, the number of generated\nnon-EOS tokens, the ",[246,299,300],{},[227,301,302],{},"StopReason"," (",[227,305,306],{},"Length",", ",[227,309,310],{},"Eos",[227,312,313],{},"Stop",[227,315,316],{},"ToolCalls",")\nand optional per-token ",[246,319,320],{},[227,321,322],{},"CompletionLogprobs",".",[232,325,327],{"id":326},"completion-options","Completion options",[223,329,330,331,334],{},"For stop sequences, logprobs, suffixes, prompt echoing, logit biases,\nsampler settings and the minimum-tokens guard, use ",[227,332,333],{},"CompletionOptions",":",[237,336,338],{"className":239,"code":337,"language":241,"meta":242,"style":242},"use llama_crab::high_level::completion::{CompletionOptions, SamplingOptions};\nuse llama_crab::{Llama, LlamaParams};\n\nlet mut llama = Llama::load(LlamaParams::new(\"models\u002Fmodel.gguf\"))?;\nlet options = CompletionOptions::new(96)\n    .with_stop_sequence(\"\\n\\n\")\n    .with_stop_sequences([\"\u003C\u002Fanswer>\", \"### END\"])\n    .with_logprobs(3)\n    .with_min_tokens(8)\n    .with_echo_prompt(false)\n    .with_sampling(SamplingOptions::chat().with_temperature(0.2));\n\nlet response = llama.create_completion_with_options(\"Explain Rust ownership:\", options)?;\nprintln!(\"{}\", response.text);\n",[227,339,340,345,349,353,358,363,369,375,381,387,393,399,404,410],{"__ignoreMap":242},[246,341,342],{"class":248,"line":249},[246,343,344],{},"use llama_crab::high_level::completion::{CompletionOptions, SamplingOptions};\n",[246,346,347],{"class":248,"line":255},[246,348,252],{},[246,350,351],{"class":248,"line":262},[246,352,259],{"emptyLinePlaceholder":258},[246,354,355],{"class":248,"line":268},[246,356,357],{},"let mut llama = Llama::load(LlamaParams::new(\"models\u002Fmodel.gguf\"))?;\n",[246,359,360],{"class":248,"line":274},[246,361,362],{},"let options = CompletionOptions::new(96)\n",[246,364,366],{"class":248,"line":365},6,[246,367,368],{},"    .with_stop_sequence(\"\\n\\n\")\n",[246,370,372],{"class":248,"line":371},7,[246,373,374],{},"    .with_stop_sequences([\"\u003C\u002Fanswer>\", \"### END\"])\n",[246,376,378],{"class":248,"line":377},8,[246,379,380],{},"    .with_logprobs(3)\n",[246,382,384],{"class":248,"line":383},9,[246,385,386],{},"    .with_min_tokens(8)\n",[246,388,390],{"class":248,"line":389},10,[246,391,392],{},"    .with_echo_prompt(false)\n",[246,394,396],{"class":248,"line":395},11,[246,397,398],{},"    .with_sampling(SamplingOptions::chat().with_temperature(0.2));\n",[246,400,402],{"class":248,"line":401},12,[246,403,259],{"emptyLinePlaceholder":258},[246,405,407],{"class":248,"line":406},13,[246,408,409],{},"let response = llama.create_completion_with_options(\"Explain Rust ownership:\", options)?;\n",[246,411,413],{"class":248,"line":412},14,[246,414,277],{},[223,416,417,418,421,422,425,426,429,430,433,434,437,438,441,442,445,446,449,450,453],{},"The constructor is ",[227,419,420],{},"CompletionOptions::new(max_tokens)"," which sets\n",[227,423,424],{},"temperature = 0.0"," (greedy). ",[227,427,428],{},"CompletionOptions::sampled(max_tokens)"," is\nthe alternative starting point and uses the probabilistic defaults in\n",[227,431,432],{},"SamplingOptions::default()"," (temperature ",[227,435,436],{},"0.8",", top-k ",[227,439,440],{},"40",", top-p ",[227,443,444],{},"0.95",",\nmin-p ",[227,447,448],{},"0.05",", repeat-penalty ",[227,451,452],{},"1.0",", mirostat disabled, no fixed seed).",[223,455,456,459,460,463,464,307,467,470,471,307,474,307,477,307,480,307,483,307,486,470,489,307,492,307,495,307,498,470,501,307,504,507,508,511,512,515,516,323],{},[227,457,458],{},"SamplingOptions::chat()"," is a thin convenience that lowers the default\ntemperature to ",[227,461,462],{},"0.2",". The full set of sampling fields (",[227,465,466],{},"top_k",[227,468,469],{},"top_p",",\n",[227,472,473],{},"min_p",[227,475,476],{},"typical_p",[227,478,479],{},"tfs_z",[227,481,482],{},"min_keep",[227,484,485],{},"penalty_last_n",[227,487,488],{},"repeat_penalty",[227,490,491],{},"frequency_penalty",[227,493,494],{},"presence_penalty",[227,496,497],{},"mirostat_mode",[227,499,500],{},"mirostat_tau",[227,502,503],{},"mirostat_eta",[227,505,506],{},"seed",") is on ",[227,509,510],{},"SamplingOptions","; use the ",[227,513,514],{},"with_*"," setters\nor replace the struct with ",[227,517,518],{},"with_sampling(...)",[232,520,92],{"id":521},"streaming",[223,523,524,525,528],{},"Streaming calls your callback once per generated chunk. Return\n",[227,526,527],{},"StreamControl::Stop"," to abort generation early.",[237,530,532],{"className":239,"code":531,"language":241,"meta":242,"style":242},"use std::io::{self, Write};\nuse llama_crab::{CompletionOptions, Llama, LlamaParams, StreamControl};\n\nlet mut llama = Llama::load(LlamaParams::new(\"models\u002Fmodel.gguf\"))?;\nlet mut out = io::stdout().lock();\n\nlet final_completion = llama.create_completion_stream(\n    \"Write one short sentence about Rust.\",\n    CompletionOptions::new(64),\n    |chunk| {\n        let _ = write!(out, \"{}\", chunk.text);\n        let _ = out.flush();\n        StreamControl::Continue\n    },\n)?;\n",[227,533,534,539,544,548,552,557,561,566,571,576,581,586,591,596,601],{"__ignoreMap":242},[246,535,536],{"class":248,"line":249},[246,537,538],{},"use std::io::{self, Write};\n",[246,540,541],{"class":248,"line":255},[246,542,543],{},"use llama_crab::{CompletionOptions, Llama, LlamaParams, StreamControl};\n",[246,545,546],{"class":248,"line":262},[246,547,259],{"emptyLinePlaceholder":258},[246,549,550],{"class":248,"line":268},[246,551,357],{},[246,553,554],{"class":248,"line":274},[246,555,556],{},"let mut out = io::stdout().lock();\n",[246,558,559],{"class":248,"line":365},[246,560,259],{"emptyLinePlaceholder":258},[246,562,563],{"class":248,"line":371},[246,564,565],{},"let final_completion = llama.create_completion_stream(\n",[246,567,568],{"class":248,"line":377},[246,569,570],{},"    \"Write one short sentence about Rust.\",\n",[246,572,573],{"class":248,"line":383},[246,574,575],{},"    CompletionOptions::new(64),\n",[246,577,578],{"class":248,"line":389},[246,579,580],{},"    |chunk| {\n",[246,582,583],{"class":248,"line":395},[246,584,585],{},"        let _ = write!(out, \"{}\", chunk.text);\n",[246,587,588],{"class":248,"line":401},[246,589,590],{},"        let _ = out.flush();\n",[246,592,593],{"class":248,"line":406},[246,594,595],{},"        StreamControl::Continue\n",[246,597,598],{"class":248,"line":412},[246,599,600],{},"    },\n",[246,602,604],{"class":248,"line":603},15,[246,605,606],{},")?;\n",[223,608,609,612,613,616,617,620,621,624,625,627,628,631,632,634,635,637],{},[227,610,611],{},"CompletionChunk"," carries the freshly emitted ",[227,614,615],{},"text",", the ",[227,618,619],{},"LlamaToken"," that\nproduced it, a cumulative ",[227,622,623],{},"n_tokens"," counter, an optional ",[227,626,302],{}," on\nthe terminal chunk, and optional ",[227,629,630],{},"logprobs"," for that token. See the\n",[227,633,521],{}," example in ",[227,636,290],{}," for the full error-handling\nversion.",[232,639,641],{"id":640},"custom-sampler","Custom sampler",[223,643,644,645,647,648,334],{},"If the built-in ",[227,646,510],{}," is not enough, build a sampler chain and\npass it to ",[227,649,650],{},"create_completion_with_sampler",[237,652,654],{"className":239,"code":653,"language":241,"meta":242,"style":242},"use llama_crab::high_level::completion::{CompletionOptions, SamplingOptions};\nuse llama_crab::sampling::LlamaSampler;\nuse llama_crab::{Llama, LlamaParams};\n\nlet mut llama = Llama::load(LlamaParams::new(\"models\u002Fmodel.gguf\"))?;\n\n\u002F\u002F Build a custom sampler chain.\nlet penalties = LlamaSampler::penalties(64, 1.1, 0.0, 0.0)\n    .expect(\"penalties sampler\");\nlet top_p = LlamaSampler::top_p(0.9, 1).expect(\"top_p sampler\");\nlet temp = LlamaSampler::temp(0.7).expect(\"temp sampler\");\nlet dist = LlamaSampler::dist(42).expect(\"dist sampler\");\nlet mut sampler = LlamaSampler::chain(\n    vec![penalties, top_p, temp, dist],\n    \u002F* no_perf *\u002F false,\n)\n.expect(\"sampler chain\");\n\n\u002F\u002F Or, build one from the SamplingOptions struct:\nlet _ = SamplingOptions::default().build_sampler(&llama);\n\nlet response = llama.create_completion_with_sampler(\n    \"Return one JSON object:\",\n    CompletionOptions::new(64),\n    &mut sampler,\n)?;\nprintln!(\"{}\", response.text);\n",[227,655,656,660,665,669,673,677,681,686,691,696,701,706,711,716,721,726,732,738,743,749,755,760,766,772,777,783,788],{"__ignoreMap":242},[246,657,658],{"class":248,"line":249},[246,659,344],{},[246,661,662],{"class":248,"line":255},[246,663,664],{},"use llama_crab::sampling::LlamaSampler;\n",[246,666,667],{"class":248,"line":262},[246,668,252],{},[246,670,671],{"class":248,"line":268},[246,672,259],{"emptyLinePlaceholder":258},[246,674,675],{"class":248,"line":274},[246,676,357],{},[246,678,679],{"class":248,"line":365},[246,680,259],{"emptyLinePlaceholder":258},[246,682,683],{"class":248,"line":371},[246,684,685],{},"\u002F\u002F Build a custom sampler chain.\n",[246,687,688],{"class":248,"line":377},[246,689,690],{},"let penalties = LlamaSampler::penalties(64, 1.1, 0.0, 0.0)\n",[246,692,693],{"class":248,"line":383},[246,694,695],{},"    .expect(\"penalties sampler\");\n",[246,697,698],{"class":248,"line":389},[246,699,700],{},"let top_p = LlamaSampler::top_p(0.9, 1).expect(\"top_p sampler\");\n",[246,702,703],{"class":248,"line":395},[246,704,705],{},"let temp = LlamaSampler::temp(0.7).expect(\"temp sampler\");\n",[246,707,708],{"class":248,"line":401},[246,709,710],{},"let dist = LlamaSampler::dist(42).expect(\"dist sampler