Signal",", the client invokes ",[234,1478,1479],{},"plugin:llama-crab|cancel"," with the ",[234,1482,1483],{},"requestId"," captured from the first chunk.",[227,1486,1488],{"id":1487},"validation-errors","Validation errors",[223,1490,1491,1493,1494,302,1496,1499],{},[234,1492,1398],{}," throws ",[234,1495,252],{},[234,1497,1498],{},"code: \"invalid_request\"",") when:",[1501,1502,1503,1508,1513,1519,1525],"ul",{},[1389,1504,1505,1507],{},[234,1506,256],{}," is missing or empty.",[1389,1509,1510,1512],{},[234,1511,260],{}," is empty (chat).",[1389,1514,1515,1518],{},[234,1516,1517],{},"prompt"," is an empty array (completion).",[1389,1520,1521,1524],{},[234,1522,1523],{},"input"," is an empty array (embedding).",[1389,1526,1527,1529],{},[234,1528,700],{}," is empty (rerank).",[223,1531,1532,1533,1536,1537,1540,1541,571,1544,571,1547,571,1550,571,1553,571,1556,571,1559,571,1562,571,1564,1567,1568,1571],{},"The Tauri client also forwards the Rust-side ",[234,1534,1535],{},"PluginError"," payloads (",[234,1538,1539],{},"kind"," discriminator: ",[234,1542,1543],{},"invalidRequest",[234,1545,1546],{},"modelNotFound",[234,1548,1549],{},"workerSpawnFailed",[234,1551,1552],{},"workerDisconnected",[234,1554,1555],{},"workerPanicked",[234,1557,1558],{},"multimodalNotEnabled",[234,1560,1561],{},"multimodalSetup",[234,1563,910],{},[234,1565,1566],{},"inference",") when an ",[234,1569,1570],{},"invoke"," rejects.",[1573,1574,1575],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-