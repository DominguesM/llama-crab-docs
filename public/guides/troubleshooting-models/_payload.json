eleases","\u002Fcontributing\u002Freleases","9.contributing\u002F3.releases","i-lucide-rocket",{"title":213,"path":214,"stem":215,"icon":216},"Troubleshooting","\u002Ftroubleshooting","troubleshooting","i-lucide-life-buoy",{"id":218,"title":160,"body":219,"description":696,"extension":697,"links":698,"meta":699,"navigation":700,"path":161,"seo":701,"stem":162,"__hash__":702},"docs\u002F6.guides\u002F3.troubleshooting-models.md",{"type":220,"value":221,"toc":688},"minimark",[222,226,253,260,265,268,282,297,338,349,353,364,368,371,414,418,421,453,456,484,506,510,513,574,578,611,614,679,684],[223,224,225],"p",{},"Most runtime issues come from a mismatch between model file, feature\nflags, backend, context size, or command arguments. Start from the\nsmallest model that exercises the feature you need.",[227,228,234],"pre",{"className":229,"code":230,"filename":231,"language":232,"meta":233,"style":233},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","llama-crab-server --model \u002Fmodels\u002Fsmall-chat.gguf\n","Terminal","bash","",[235,236,237],"code",{"__ignoreMap":233},[238,239,242,246,250],"span",{"class":240,"line":241},"line",1,[238,243,245],{"class":244},"sBMFI","llama-crab-server",[238,247,249],{"class":248},"sfazB"," --model",[238,251,252],{"class":248}," \u002Fmodels\u002Fsmall-chat.gguf\n",[223,254,255,256,259],{},"The high-level ",[257,258,213],"a",{"href":214}," page covers the\ntop-level failure modes (server start, streaming, multimodal, Tauri IPC,\nTS client validation). This page focuses on the model, backend, and\nallocation issues that usually surface first.",[261,262,264],"h2",{"id":263},"model-file-not-found","Model file not found",[223,266,267],{},"Download the model files required by the feature you are testing, then\npass their absolute paths to your application or server process.",[227,269,271],{"className":229,"code":270,"filename":231,"language":232,"meta":233,"style":233},"llama-crab-server --model \u002Fabsolute\u002Fpath\u002Fto\u002Fmodel.gguf\n",[235,272,273],{"__ignoreMap":233},[238,274,275,277,279],{"class":240,"line":241},[238,276,245],{"class":244},[238,278,249],{"class":248},[238,280,281],{"class":248}," \u002Fabsolute\u002Fpath\u002Fto\u002Fmodel.gguf\n",[223,283,284,285,288,289,292,293,296],{},"In 0.1.8 the ",[235,286,287],{},"hf-hub"," cargo feature also lets ",[235,290,291],{},"--model"," accept a\nHugging Face repository id; combine it with ",[235,294,295],{},"--hf-filename"," to pick the\nGGUF file inside the repo:",[227,298,300],{"className":229,"code":299,"filename":231,"language":232,"meta":233,"style":233},"llama-crab-server \\\n  --hf-hub \\\n  --model Qwen\u002FQwen2.5-0.5B-Instruct-GGUF \\\n  --hf-filename qwen2.5-0.5b-instruct-q4_k_m.gguf\n",[235,301,302,310,318,329],{"__ignoreMap":233},[238,303,304,306],{"class":240,"line":241},[238,305,245],{"class":244},[238,307,309],{"class":308},"sTEyZ"," \\\n",[238,311,313,316],{"class":240,"line":312},2,[238,314,315],{"class":248},"  --hf-hub",[238,317,309],{"class":308},[238,319,321,324,327],{"class":240,"line":320},3,[238,322,323],{"class":248},"  --model",[238,325,326],{"class":248}," Qwen\u002FQwen2.5-0.5B-Instruct-GGUF",[238,328,309],{"class":308},[238,330,332,335],{"class":240,"line":331},4,[238,333,334],{"class":248},"  --hf-filename",[238,336,337],{"class":248}," qwen2.5-0.5b-instruct-q4_k_m.gguf\n",[223,339,340,341,344,345,348],{},"If the model still fails to load, the Rust crate surfaces the failure as\n",[235,342,343],{},"LlamaError::ModelDownload"," (HF resolver\u002Fcache) or\n",[235,346,347],{},"LlamaError::ModelLoad"," (everything else).",[261,350,352],{"id":351},"first-build-is-slow","First build is slow",[223,354,355,356,359,360,363],{},"The first build compiles ",[235,357,358],{},"llama-crab-sys"," and the selected llama.cpp\nbackends. Subsequent builds should reuse Cargo artifacts unless features\nor source files change. CI and release workflows install extra\ndependencies (Vulkan shader compiler, etc.) — see the workflows under\n",[235,361,362],{},".github\u002Fworkflows\u002F"," if your local build matches the matrix.",[261,365,367],{"id":366},"allocation-failures","Allocation failures",[223,369,370],{},"If loading or context allocation fails:",[372,373,374,378,385,394,400],"ol",{},[375,376,377],"li",{},"Use a smaller quantized model.",[375,379,380,381,384],{},"Reduce ",[235,382,383],{},"n_ctx",".",[375,386,380,387,390,391,384],{},[235,388,389],{},"n_batch"," and ",[235,392,393],{},"n_ubatch",[375,395,396,397,384],{},"Lower ",[235,398,399],{},"n_gpu_layers",[375,401,402,403,406,407,410,411,413],{},"Disable optional features you do not need (e.g. ",[235,404,405],{},"mtmd"," for text-only\nwork, ",[235,408,409],{},"llguidance"," if you do not use the alternative grammar\nbackend, ",[235,412,287],{}," for fully offline flows).",[261,415,417],{"id":416},"vision-model-does-not-see-the-image","Vision model does not see the image",[223,419,420],{},"Check all of these:",[422,423,424,431,441,447,450],"ul",{},[375,425,426,427,430],{},"The text GGUF and ",[235,428,429],{},"mmproj"," file come from the same model family and\nquantization lineage.",[375,432,433,434,436,437,440],{},"The binary was built with the ",[235,435,405],{}," cargo feature\n(",[235,438,439],{},"cargo install llama-crab-server --features mtmd --force",").",[375,442,443,444,384],{},"The prompt contains ",[235,445,446],{},"default_media_marker()",[375,448,449],{},"The image path is readable.",[375,451,452],{},"The prompt template matches the model family.",[223,454,455],{},"Start with one known-good image and one short prompt before increasing\nimage size or context length:",[227,457,459],{"className":229,"code":458,"filename":231,"language":232,"meta":233,"style":233},"llama-crab-server \\\n  --model \u002Fmodels\u002Fvision.gguf \\\n  --mmproj \u002Fmodels\u002Fmmproj.gguf\n",[235,460,461,467,476],{"__ignoreMap":233},[238,462,463,465],{"class":240,"line":241},[238,464,245],{"class":244},[238,466,309],{"class":308},[238,468,469,471,474],{"class":240,"line":312},[238,470,323],{"class":248},[238,472,473],{"class":248}," \u002Fmodels\u002Fvision.gguf",[238,475,309],{"class":308},[238,477,478,481],{"class":240,"line":320},[238,479,480],{"class":248},"  --mmproj",[238,482,483],{"class":248}," \u002Fmodels\u002Fmmproj.gguf\n",[223,485,486,487,490,491,494,495,498,499,502,503,384],{},"The HTTP server currently accepts ",[235,488,489],{},"image_url"," parts in multimodal chat\nand rejects ",[235,492,493],{},"audio_url"," \u002F ",[235,496,497],{},"video_url"," parts at bitmap load time with\n",[235,500,501],{},"unsupported multimodal chat content part type: audio\u002Fvideo",". The Tauri\nplugin accepts the same image inputs and rejects audio input with\n",[235,504,505],{},"PluginError { kind: \"mediaDecode\" }",[261,507,509],{"id":508},"embeddings-or-reranking-look-wrong","Embeddings or reranking look wrong",[223,511,512],{},"Embedding models are more sensitive to pooling and backend details than\nsimple text completion. If vector dimensions, norms, ranking scores, or\ncrashes differ between environments:",[372,514,515,518,529,543,554,557],{},[375,516,517],{},"Confirm the model path is the intended embedding or reranker GGUF.",[375,519,520,521,524,525,528],{},"Confirm embeddings are enabled with ",[235,522,523],{},"LlamaParams::with_embeddings(true)","\nor the server's ",[235,526,527],{},"--embeddings"," flag.",[375,530,531,532,535,536,539,540,528],{},"For BGE-small semantic search, confirm ",[235,533,534],{},"PoolingType::Cls",". For\nrerankers, confirm ",[235,537,538],{},"PoolingType::Rank"," and the ",[235,541,542],{},"--reranking",[375,544,545,546,549,550,553],{},"Compare backend features such as ",[235,547,548],{},"metal",", ",[235,551,552],{},"openmp",", or other\naccelerators.",[375,555,556],{},"Validate embeddings separately from text generation; a chat model\npass does not prove that pooling, vector dimensions, or ranking\nscores are configured correctly.",[375,558,559,560,563,564,567,568,571,572,440],{},"Be aware that ",[235,561,562],{},"normalize"," on the embeddings endpoint defaults to\n",[235,565,566],{},"false"," (the previous draft of this page said ",[235,569,570],{},"true"," — the server\nbehaviour is ",[235,573,566],{},[261,575,577],{"id":576},"server-route-returns-disabled-feature-errors","Server route returns disabled feature errors",[223,579,580,583,584,586,587,590,591,549,594,549,597,600,601,603,604,606,607,610],{},[235,581,582],{},"\u002Fv1\u002Fembeddings"," requires the server to start with ",[235,585,527],{},".\n",[235,588,589],{},"\u002Fv1\u002Frerank"," (and the ",[235,592,593],{},"\u002Fv1\u002Freranking",[235,595,596],{},"\u002Frerank",[235,598,599],{},"\u002Freranking"," aliases)\nrequire ",[235,602,542],{},". Multimodal chat requires the ",[235,605,405],{}," cargo\nfeature on the server binary and the ",[235,608,609],{},"--mmproj"," flag at startup.",[223,612,613],{},"Examples:",[227,615,617],{"className":229,"code":616,"filename":231,"language":232,"meta":233,"style":233},"llama-crab-server \\\n  --model models\u002Fbge-small-en-v1.5-q4_k_m.gguf \\\n  --embeddings\n\nllama-crab-server \\\n  --model models\u002Freranker.gguf \\\n  --reranking \\\n  --pooling rank\n",[235,618,619,625,634,639,645,652,662,670],{"__ignoreMap":233},[238,620,621,623],{"class":240,"line":241},[238,622,245],{"class":244},[238,624,309],{"class":308},[238,626,627,629,632],{"class":240,"line":312},[238,628,323],{"class":248},[238,630,631],{"class":248}," models\u002Fbge-small-en-v1.5-q4_k_m.gguf",[238,633,309],{"class":308},[238,635,636],{"class":240,"line":320},[238,637,638],{"class":248},"  --embeddings\n",[238,640,641],{"class":240,"line":331},[238,642,644],{"emptyLinePlaceholder":643},true,"\n",[238,646,648,650],{"class":240,"line":647},5,[238,649,245],{"class":244},[238,651,309],{"class":308},[238,653,655,657,660],{"class":240,"line":654},6,[238,656,323],{"class":248},[238,658,659],{"class":248}," models\u002Freranker.gguf",[238,661,309],{"class":308},[238,663,665,668],{"class":240,"line":664},7,[238,666,667],{"class":248},"  --reranking",[238,669,309],{"class":308},[238,671,673,676],{"class":240,"line":672},8,[238,674,675],{"class":248},"  --pooling",[238,677,678],{"class":248}," rank\n",[223,680,681,682,384],{},"Repository wrappers and model download scripts are documented in\n",[257,683,201],{"href":202},[685,686,687],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(-