buting\u002Freleases","9.contributing\u002F3.releases","i-lucide-rocket",{"title":213,"path":214,"stem":215,"icon":216},"Troubleshooting","\u002Ftroubleshooting","troubleshooting","i-lucide-life-buoy",{"id":218,"title":150,"body":219,"description":520,"extension":521,"links":522,"meta":523,"navigation":524,"path":151,"seo":525,"stem":152,"__hash__":526},"docs\u002F6.guides\u002F1.performance.md",{"type":220,"value":221,"toc":511},"minimark",[222,226,229,256,261,268,284,287,291,305,335,338,342,345,364,379,383,389,398,409,413,423,434,450,454,457,476,482,486,507],[223,224,225],"p",{},"These guides cover the operational choices that usually matter after the\nfirst example runs.",[223,227,228],{},"Start with the smallest model that exercises your workload, then tune one\nvariable at a time.",[230,231,237],"pre",{"className":232,"code":233,"filename":234,"language":235,"meta":236,"style":236},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","llama-crab-server --model \u002Fmodels\u002Fsmall-chat.gguf\n","Terminal","bash","",[238,239,240],"code",{"__ignoreMap":236},[241,242,245,249,253],"span",{"class":243,"line":244},"line",1,[241,246,248],{"class":247},"sBMFI","llama-crab-server",[241,250,252],{"class":251},"sfazB"," --model",[241,254,255],{"class":251}," \u002Fmodels\u002Fsmall-chat.gguf\n",[257,258,260],"h2",{"id":259},"build-in-release-mode","Build in release mode",[223,262,263,264,267],{},"Use ",[238,265,266],{},"--release"," for realistic inference behavior:",[230,269,271],{"className":232,"code":270,"filename":234,"language":235,"meta":236,"style":236},"cargo run --release\n",[238,272,273],{"__ignoreMap":236},[241,274,275,278,281],{"class":243,"line":244},[241,276,277],{"class":247},"cargo",[241,279,280],{"class":251}," run",[241,282,283],{"class":251}," --release\n",[223,285,286],{},"Debug builds are useful for Rust diagnostics, but llama.cpp inference is\nmuch slower and some backend-sensitive paths are easier to evaluate in\nrelease mode.",[257,288,290],{"id":289},"context-and-batch-size","Context and batch size",[223,292,293,296,297,300,301,304],{},[238,294,295],{},"n_ctx"," controls the maximum prompt plus generation window. Larger values\nuse more memory. ",[238,298,299],{},"n_batch"," and ",[238,302,303],{},"n_ubatch"," control how much work is fed\nthrough the model at once.",[230,306,310],{"className":307,"code":308,"language":309,"meta":236,"style":236},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","let params = LlamaParams::new(\"models\u002Fmodel.gguf\")\n    .with_n_ctx(4096)\n    .with_n_batch(512)\n    .with_n_ubatch(256);\n","rust",[238,311,312,317,323,329],{"__ignoreMap":236},[241,313,314],{"class":243,"line":244},[241,315,316],{},"let params = LlamaParams::new(\"models\u002Fmodel.gguf\")\n",[241,318,320],{"class":243,"line":319},2,[241,321,322],{},"    .with_n_ctx(4096)\n",[241,324,326],{"class":243,"line":325},3,[241,327,328],{},"    .with_n_batch(512)\n",[241,330,332],{"class":243,"line":331},4,[241,333,334],{},"    .with_n_ubatch(256);\n",[223,336,337],{},"If allocation fails, reduce context first, then batch sizes, then choose a\nsmaller quantized model.",[257,339,341],{"id":340},"cpu-threads","CPU threads",[223,343,344],{},"Set explicit thread counts when you want reproducible local behavior:",[230,346,348],{"className":307,"code":347,"language":309,"meta":236,"style":236},"let params = LlamaParams::new(\"models\u002Fmodel.gguf\")\n    .with_n_threads(4)\n    .with_n_threads_batch(4);\n",[238,349,350,354,359],{"__ignoreMap":236},[241,351,352],{"class":243,"line":244},[241,353,316],{},[241,355,356],{"class":243,"line":319},[241,357,358],{},"    .with_n_threads(4)\n",[241,360,361],{"class":243,"line":325},[241,362,363],{},"    .with_n_threads_batch(4);\n",[223,365,366,367,300,370,373,374,378],{},"The server exposes the same knobs as ",[238,368,369],{},"--n-threads",[238,371,372],{},"--n-batch"," style\nflags (see ",[375,376,377],"a",{"href":84},"Server: Running"," for the full flag table).",[257,380,382],{"id":381},"gpu-offload","GPU offload",[223,384,385,388],{},[238,386,387],{},"with_n_gpu_layers"," controls how many layers are offloaded to the active\nbackend:",[230,390,392],{"className":307,"code":391,"language":309,"meta":236,"style":236},"let params = LlamaParams::new(\"models\u002Fmodel.gguf\").with_n_gpu_layers(99);\n",[238,393,394],{"__ignoreMap":236},[241,395,396],{"class":243,"line":244},[241,397,391],{},[223,399,400,401,404,405,408],{},"The right value depends on model size, backend, and available VRAM or\nunified memory. If startup fails after increasing offload, lower this\nvalue before changing unrelated settings. ",[238,402,403],{},"-1"," (or ",[238,406,407],{},"99",") means \"offload\nevery layer\"; pass an explicit number when you want to leave a few layers\non the CPU for host memory pressure.",[257,410,412],{"id":411},"feature-selection","Feature selection",[223,414,415,416,300,419,422],{},"The default crate features enable ",[238,417,418],{},"openmp",[238,420,421],{},"metal",". On non-Apple\ntargets or CI, you may want explicit features:",[230,424,428],{"className":425,"code":426,"language":427,"meta":236,"style":236},"language-toml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","llama-crab = { version = \"0.1.8\", default-features = false, features = [\"openmp\"] }\n","toml",[238,429,430],{"__ignoreMap":236},[241,431,432],{"class":243,"line":244},[241,433,426],{},[223,435,436,437,439,440,443,444,439,446,449],{},"Use only one primary accelerator backend unless you have a reason to\ncompile several (e.g. ",[238,438,421],{}," + ",[238,441,442],{},"vulkan"," is usually wasted, but\n",[238,445,442],{},[238,447,448],{},"opencl"," can be useful for cross-vendor CI).",[257,451,453],{"id":452},"measure-the-right-layer","Measure the right layer",[223,455,456],{},"For application tuning, measure:",[458,459,460,464,467,470,473],"ul",{},[461,462,463],"li",{},"model load time,",[461,465,466],{},"prompt token count,",[461,468,469],{},"time to first token,",[461,471,472],{},"generated tokens per second,",[461,474,475],{},"peak memory.",[223,477,478,479,481],{},"For serious benchmarking, use a dedicated harness with fixed prompts,\nfixed sampler settings, and warm caches. Repository examples and wrappers\nfor local validation are covered in\n",[375,480,201],{"href":202},".",[257,483,485],{"id":484},"mobile-presets","Mobile presets",[223,487,488,489,491,492,495,496,499,500,503,504,481],{},"For phones, tablets, and other memory-constrained targets, prefer the\nbuilt-in ",[375,490,485],{"href":156}," (",[238,493,494],{},"MobilePreset::LowRam",",\n",[238,497,498],{},"Balanced",", ",[238,501,502],{},"GpuMax",") before hand-tuning every parameter. The server\nmirrors them through ",[238,505,506],{},"--mobile-preset low-ram | balanced | gpu-max",[508,509,510],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style